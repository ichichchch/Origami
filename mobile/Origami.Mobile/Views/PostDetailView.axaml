<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Origami.Mobile.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="800"
             x:Class="Origami.Mobile.Views.PostDetailView"
             x:DataType="vm:PostDetailViewModel">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="10" MaxWidth="760">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Meta}" Opacity="0.65" TextWrapping="Wrap" />
            <Separator />
            <TextBlock Text="{Binding Message}" Foreground="Red" TextWrapping="Wrap" />
            <!-- v1 renders the Markdown source as selectable text; rich rendering is a later round. -->
            <SelectableTextBlock Text="{Binding Markdown}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
