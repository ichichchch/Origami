<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Origami.Mobile.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="800"
             x:Class="Origami.Mobile.Views.ShellView"
             x:DataType="vm:ShellViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="10,8">
            <Button Content="←" Command="{Binding BackCommand}" IsVisible="{Binding Navigator.CanBack}"
                    VerticalAlignment="Center" />
            <TextBlock Text="Origami" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <ContentControl Content="{Binding Navigator.Current}" />
    </DockPanel>
</UserControl>
