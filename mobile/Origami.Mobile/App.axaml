<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Origami.Mobile"
             x:Class="Origami.Mobile.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant 會跟隨系統主題；"Dark" 與 "Light" 是其他可用選項。 -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>