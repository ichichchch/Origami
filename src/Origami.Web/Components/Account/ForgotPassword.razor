@page "/account/forgot-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject PasswordResetService PasswordReset
@inject ILogger<ForgotPassword> Logger

<PageTitle>@UiText.T("Account.ForgotPassword.PageTitle", "重設密碼 · 內容工作室")</PageTitle>

<section class="auth-card" aria-labelledby="forgot-title">
    <p class="eyebrow">@UiText.T("Account.Brand", "ORIGAMI · 內容工作室")</p>
    <h1 id="forgot-title">@UiText.T("Account.ForgotPassword.Title", "忘記密碼")</h1>

    @if (sent)
    {
        @* 不論帳號是否存在都顯示相同訊息，避免洩漏註冊情形。 *@
        <p class="notice notice-success" role="status">@UiText.T("Account.ForgotPassword.Sent", "若該電子郵件已註冊且帳號可用，重設連結已寄出。請查收信箱（包含垃圾郵件）；連結 30 分鐘內有效。")</p>
    }
    else
    {
        @* Static SSR 的 EditForm 內含防偽權杖，並在 POST 時驗證。 *@
        <EditForm Model="Input" method="post" OnValidSubmit="SendAsync" FormName="account-forgot-password" Enhance="false">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="field">
                <label for="email">@UiText.T("Account.ForgotPassword.Email", "電子郵件")</label>
                <InputText id="email" @bind-Value="Input.Email" autocomplete="email" maxlength="256" required />
            </div>
            <button type="submit" class="button full-width">@UiText.T("Account.ForgotPassword.Submit", "寄出重設連結")</button>
        </EditForm>
        <p class="field-help">@UiText.T("Account.ForgotPassword.Help", "本網站不提供公開註冊。沒有電子郵件的帳號請聯絡站點管理員，或由管理者在伺服器端重設密碼。")</p>
    }

    <p class="field-help"><a href="/account/login">@UiText.T("Account.ForgotPassword.BackToLogin", "回到登入")</a></p>
</section>

@code {
    [SupplyParameterFromForm(FormName = "account-forgot-password")]
    private InputModel Input { get; set; } = default!;

    private bool sent;

    public static class ValidationText
    {
        public static string EmailRequired => UiText.T("Account.ForgotPassword.EmailRequired", "請輸入電子郵件。");
        public static string EmailInvalid => UiText.T("Account.ForgotPassword.EmailInvalid", "電子郵件格式不正確。");
        public static string EmailTooLong => UiText.T("Account.ForgotPassword.EmailTooLong", "電子郵件過長。");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EmailRequired))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EmailInvalid))]
        [StringLength(256, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EmailTooLong))]
        public string Email { get; set; } = "";
    }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized() => Input ??= new InputModel();

    private async Task SendAsync()
    {
        var email = (Input?.Email ?? "").Trim();
        if (email.Length == 0) { sent = true; return; }
        var remoteIp = HttpContext?.Connection.RemoteIpAddress?.ToString() ?? "unknown";
        // 以「來源 IP＋電子郵件」為鍵限流，避免被用來大量寄信或猜測帳號。
        var throttle = HttpContext?.RequestServices.GetRequiredService<LoginThrottle>();
        if (throttle is not null && !throttle.TryAcquire("reset:" + remoteIp + ":" + email.ToLowerInvariant()))
        {
            sent = true;
            return;
        }

        var origin = HttpContext is null ? "" : HttpContext.Request.Scheme + "://" + HttpContext.Request.Host.Value;
        await PasswordReset.RequestResetAsync(email, origin);
        sent = true;
    }
}
