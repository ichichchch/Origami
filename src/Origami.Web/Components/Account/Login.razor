@page "/account/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager Navigation
@inject WebSignInFlow SignInFlow
@inject ExternalProviderCatalog Providers

<PageTitle>@UiText.T("Account.Login.PageTitle", "管理員登入")</PageTitle>

<section class="auth-card" aria-labelledby="login-title">
    <p class="eyebrow">@UiText.T("Account.Login.Brand", "ORIGAMI · 內容工作室")</p>
    <h1 id="login-title">@UiText.T("Account.Login.Title", "管理員登入")</h1>
    <p class="field-help">@UiText.T("Account.Login.Introduction", "登入後可撰寫文章、建立獨立頁面、管理圖片與使用站內 AI 助理。")</p>
    @if (errorMessage is not null)
    {
        <p class="notice notice-error" role="alert">@errorMessage</p>
    }
    @if (awaitingCode)
    {
        <p class="field-help">@UiText.T("Account.Login.SecondFactorHelp", "身份已確認，請輸入驗證器的 6 位動態碼，或 8 碼一次性備用恢復碼。")</p>
        <EditForm Model="CodeForm" method="post" OnValidSubmit="CodeAsync" OnInvalidSubmit="ClearCode" FormName="account-code" Enhance="false">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="field">
                <label for="code">@UiText.T("Account.Login.Code", "動態驗證碼或備用恢復碼")</label>
                <input id="code" name="CodeForm.Code" autocomplete="one-time-code" maxlength="10" required />
            </div>
            <button type="submit" class="button full-width">@UiText.T("Account.Login.Verify", "驗證並登入")</button>
        </EditForm>
    }
    else
    {
        <EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" OnInvalidSubmit="ClearPassword" FormName="account-login" Enhance="false">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset class="login-environment">
                <legend>@UiText.T("Account.Login.Environment", "登入環境")</legend>
                <label for="public-environment"><input id="public-environment" name="Input.Remember" type="radio" value="false" checked="@(!Input.Remember)" /> @UiText.T("Account.Login.PublicEnvironment", "公用環境 · 最長 8 小時")</label>
                <label for="remember"><input id="remember" name="Input.Remember" type="radio" value="true" checked="@Input.Remember" /> @UiText.T("Account.Login.HomeEnvironment", "家用環境 · 保持登入 30 天")</label>
                <p class="field-help">@UiText.T("Account.Login.EnvironmentHelp", "期限不會因持續操作而延長。公用設備用畢請登出；關閉瀏覽器不保證立即撤銷登入。")</p>
            </fieldset>
            <div class="field">
                <label for="username">@UiText.T("Account.Login.UserName", "帳號")</label>
                <InputText id="username" @bind-Value="Input.Username" autocomplete="username" maxlength="256" required />
            </div>
            <div class="field">
                <label for="password">@UiText.T("Account.Login.Password", "密碼")</label>
                <input id="password" name="Input.Password" type="password" autocomplete="current-password" maxlength="1024" required />
            </div>
            <button type="submit" class="button full-width">@UiText.T("Account.Login.Submit", "登入")</button>
            @if (availableProviders.Count > 0)
            {
                <div class="external-login-options">
                    <p class="field-help">@UiText.T("Account.Login.ExternalHelp", "或使用已綁定的第三方帳號登入（沿用上方登入環境）。")</p>
                    @foreach (var provider in availableProviders)
                    {
                        <button type="submit" name="provider" value="@provider.Name" formaction="/account/external/challenge" formnovalidate class="button button-secondary">@provider.DisplayName</button>
                    }
                </div>
            }
        </EditForm>
    }
    <p class="field-help"><a href="/account/forgot-password">@UiText.T("Account.Login.ForgotPassword", "忘記密碼？以電子郵件取得重設連結")</a></p>
    <details class="setup-help">
        <summary>@UiText.T("Account.Login.SetupTitle", "第一次使用，或忘記密碼？")</summary>
        <p>@UiText.T("Account.Login.RegistrationHelp", "本網站不提供公開註冊。一般帳號與站點成員資格請聯絡管理者；各網域需分別登入，不提供跨域單一登入。")</p>
        <p>@UiText.T("Account.Login.BindingHelp", "第一次使用第三方登入前，請先用原帳號登入，在個人安全設定中綁定。")</p>
        <p>@((MarkupString)string.Format(CultureInfo.CurrentCulture, WebUtility.HtmlEncode(UiText.T("Account.Login.InitializeHelp", "只有首次全站管理者初始化使用伺服器命令：{0}。")), "<code>dotnet run --project src/Origami.Web -- admin-init</code>"))</p>
        <p>@((MarkupString)string.Format(CultureInfo.CurrentCulture, WebUtility.HtmlEncode(UiText.T("Account.Login.ResetHelp", "{0} 只恢復全站管理者密碼並停用其兩步驟驗證，不會修改其他使用者。密碼仍由終端機互動輸入，不可放入命令列。")), "<code>admin-reset</code>"))</p>
    </details>
</section>

@code {
    private static string LoginFailure => UiText.T("Account.Login.LoginFailure", "無法登入。請確認帳號密碼，或稍後再試。");
    private string? errorMessage;
    private bool awaitingCode;
    private IReadOnlyList<ExternalProviderDescriptor> availableProviders = [];

    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? LoginError { get; set; }
    [SupplyParameterFromForm(FormName = "account-login")] private LoginInput Input { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "account-code")] private CodeInput CodeForm { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        CodeForm ??= new();
        if (HttpContext is null)
        {
            Navigation.NavigateTo("/account/login", forceLoad: true);
            return;
        }
        awaitingCode = SignInFlow.ReadPending(HttpContext) is not null;
        availableProviders = Providers.ForOrigin(WebSignInFlow.Origin(HttpContext));
        errorMessage = LoginError switch
        {
            "external" => UiText.T("Account.Login.ExternalFailed", "第三方登入未完成，請重新嘗試或改用帳號密碼。"),
            "unlinked" => UiText.T("Account.Login.ExternalUnlinked", "此第三方帳號尚未綁定。請先用原帳號登入，再至個人安全設定綁定。"),
            "changed" => UiText.T("Account.Login.BindingsChanged", "第三方綁定已更新，既有登入及 API 憑證已失效，請重新登入。"),
            _ => null
        };
    }

    private bool CanSubmit()
    {
        if (HttpContext is null || !HttpMethods.IsPost(HttpContext.Request.Method) || HttpContext.Response.HasStarted)
        {
            Navigation.NavigateTo("/account/login", forceLoad: true);
            return false;
        }
        if (SignInFlow.TryAcquire(HttpContext)) return true;
        errorMessage = UiText.T("Account.Login.Throttled", "嘗試次數過多，請稍後再試。");
        HttpContext.Response.StatusCode = StatusCodes.Status429TooManyRequests;
        return false;
    }

    private async Task LoginAsync()
    {
        var password = Input.Password;
        Input.Password = string.Empty;
        if (!CanSubmit()) return;
        try
        {
            var user = await SignInFlow.CheckPasswordAsync(Input.Username, password);
            if (user is null) { errorMessage = LoginFailure; return; }
            if (await SignInFlow.BeginAsync(HttpContext!, user, Input.Remember))
                Navigation.NavigateTo("/admin/posts", forceLoad: true);
            else awaitingCode = true;
        }
        catch (Exception exception) when (exception is DbUpdateException or DbException or CmsException)
        {
            errorMessage = LoginFailure;
        }
    }

    private async Task CodeAsync()
    {
        var code = CodeForm.Code;
        CodeForm.Code = string.Empty;
        if (!CanSubmit()) return;
        try
        {
            if (await SignInFlow.CompleteSecondFactorAsync(HttpContext!, code))
            {
                Navigation.NavigateTo("/admin/posts", forceLoad: true);
                return;
            }
        }
        catch (Exception exception) when (exception is DbUpdateException or DbException or CmsException) { }
        awaitingCode = false;
        errorMessage = UiText.T("Account.Login.CodeFailure", "驗證碼不正確或已過期，請重新登入。");
    }

    private void ClearPassword() => Input.Password = string.Empty;
    private void ClearCode() => CodeForm.Code = string.Empty;

    public static class ValidationText
    {
        public static string UserNameRequired => UiText.T("Account.Login.UserNameRequired", "請輸入帳號。");
        public static string UserNameTooLong => UiText.T("Account.Login.UserNameTooLong", "帳號過長。");
        public static string PasswordRequired => UiText.T("Account.Login.PasswordRequired", "請輸入密碼。");
        public static string PasswordTooLong => UiText.T("Account.Login.PasswordTooLong", "密碼過長。");
        public static string CodeRequired => UiText.T("Account.Login.CodeRequired", "請輸入動態驗證碼。");
        public static string CodeLength => UiText.T("Account.Login.CodeLength", "請輸入 6 位動態碼或 8 碼恢復碼。");
    }

    public sealed class LoginInput
    {
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.UserNameRequired))]
        [StringLength(AdminProvisioner.MaximumUserNameLength, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.UserNameTooLong))]
        public string Username { get; set; } = string.Empty;
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.PasswordRequired))]
        [StringLength(AdminProvisioner.MaximumPasswordLength, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.PasswordTooLong))]
        public string Password { get; set; } = string.Empty;
        public bool Remember { get; set; }
    }

    public sealed class CodeInput
    {
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.CodeRequired))]
        [StringLength(10, MinimumLength = 6, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.CodeLength))]
        public string Code { get; set; } = string.Empty;
    }
}
