@page "/account/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager Navigation

<PageTitle>管理員登入</PageTitle>

<section class="auth-card" aria-labelledby="login-title">
    <p class="eyebrow">ORIGAMI · 內容工作室</p>
    <h1 id="login-title">管理員登入</h1>
    <p class="field-help">登入後可撰寫文章、建立獨立頁面、管理圖片與使用站內 AI 助理。</p>

    @if (errorMessage is not null)
    {
        <p class="notice notice-error" role="alert">@errorMessage</p>
    }

    @* Static SSR EditForm includes an antiforgery token and validates it on POST. *@
    <EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" OnInvalidSubmit="ClearPassword" FormName="account-login" Enhance="false">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="field">
            <label for="username">帳號</label>
            <InputText id="username" @bind-Value="Input.Username" autocomplete="username" maxlength="256" required />
        </div>
        <div class="field">
            <label for="password">密碼</label>
            @* Form mapping reads this field on POST; never bind or render its submitted value. *@
            <input id="password" name="Input.Password" type="password" autocomplete="current-password" maxlength="1024" required />
        </div>
        <button type="submit" class="button full-width">登入</button>
    </EditForm>
    <details class="setup-help">
        <summary>第一次使用，或忘記密碼？</summary>
        <p>本網站僅開放一位管理員，不提供公開註冊。請在伺服器的專案目錄執行：</p>
        <p><code>dotnet run --project src/Origami.Web -- admin-init</code></p>
        <p>已有帳號要重設密碼，改用 <code>admin-reset</code>。密碼由終端機互動輸入，請勿放入命令列或分享給他人。</p>
    </details>
</section>

@code {
    private const string LoginFailure = "無法登入。請確認帳號密碼，或稍後再試。";
    private const string ThrottledMessage = "嘗試次數過多，請稍後再試。";
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "account-login")]
    private LoginInput Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        if (HttpContext is null)
        {
            // Safety net if a parent accidentally tries to render this page in a circuit.
            Navigation.NavigateTo("/account/login", forceLoad: true);
            return;
        }
        HttpContext.Response.Headers.CacheControl = "no-store";
    }

    private async Task LoginAsync()
    {
        var context = HttpContext;
        if (context is null || !HttpMethods.IsPost(context.Request.Method) || context.Response.HasStarted)
        {
            Navigation.NavigateTo("/account/login", forceLoad: true);
            return;
        }

        // Consume before checking credentials; never key by a submitted username or forwarded header.
        var throttle = context.RequestServices.GetRequiredService<LoginThrottle>();
        if (!throttle.TryAcquire(context.Connection.RemoteIpAddress?.ToString()))
        {
            Input.Password = string.Empty;
            errorMessage = ThrottledMessage;
            if (!context.Response.HasStarted) context.Response.StatusCode = StatusCodes.Status429TooManyRequests;
            return;
        }

        // Resolve only in an active HTTP request: never inject SignInManager into a circuit.
        var signInManager = context.RequestServices.GetRequiredService<SignInManager<AdminUser>>();
        Microsoft.AspNetCore.Identity.SignInResult result;
        try
        {
            result = await signInManager.PasswordSignInAsync(
                Input.Username.Trim(), Input.Password, isPersistent: false, lockoutOnFailure: true);
        }
        catch (DbUpdateException)
        {
            Input.Password = string.Empty;
            errorMessage = LoginFailure;
            return;
        }
        catch (DbException)
        {
            Input.Password = string.Empty;
            errorMessage = LoginFailure;
            return;
        }

        Input.Password = string.Empty;
        if (result.Succeeded)
        {
            // Never consume a caller-provided return URL. Cookies need a full HTTP navigation.
            Navigation.NavigateTo("/admin/posts", forceLoad: true);
            return;
        }
        // Do not disclose whether the username exists, is locked out, or is otherwise blocked.
        errorMessage = LoginFailure;
    }

    private void ClearPassword() => Input.Password = string.Empty;

    public sealed class LoginInput
    {
        [Required(ErrorMessage = "請輸入帳號。")]
        [StringLength(AdminProvisioner.MaximumUserNameLength, ErrorMessage = "帳號過長。")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "請輸入密碼。")]
        [StringLength(AdminProvisioner.MaximumPasswordLength, ErrorMessage = "密碼過長。")]
        public string Password { get; set; } = string.Empty;
    }
}
