@page "/account/reset-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject PasswordResetService PasswordReset
@inject ILogger<ResetPassword> Logger

<PageTitle>@UiText.T("Account.ResetPassword.PageTitle", "設定新密碼 · 內容工作室")</PageTitle>

<section class="auth-card" aria-labelledby="reset-title">
    <p class="eyebrow">@UiText.T("Account.Brand", "ORIGAMI · 內容工作室")</p>
    <h1 id="reset-title">@UiText.T("Account.ResetPassword.Title", "設定新密碼")</h1>

    @if (completed)
    {
        <p class="notice notice-success" role="status">@UiText.T("Account.ResetPassword.Done", "密碼已更新，請以新密碼登入。")</p>
        <p class="field-help"><a href="/account/login">@UiText.T("Account.ResetPassword.GoLogin", "前往登入")</a></p>
    }
    else
    {
        @if (errorMessage is not null)
        {
            <p class="notice notice-error" role="alert">@errorMessage</p>
        }
        @* Static SSR 的 EditForm 內含防偽權杖，並在 POST 時驗證。 *@
        <EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="account-reset-password" Enhance="false">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="field">
                <label for="reset-email">@UiText.T("Account.ResetPassword.Email", "電子郵件")</label>
                <InputText id="reset-email" @bind-Value="Input.Email" autocomplete="email" maxlength="256" required />
            </div>
            <div class="field">
                <label for="new-password">@UiText.T("Account.ResetPassword.NewPassword", "新密碼")</label>
                @* 表單對應在 POST 時讀取此欄位；絕不繫結或渲染其送出值。 *@
                <input id="new-password" name="Input.Password" type="password" autocomplete="new-password" maxlength="1024" required />
            </div>
            <div class="field">
                <label for="confirm-password">@UiText.T("Account.ResetPassword.ConfirmPassword", "再次輸入新密碼")</label>
                <input id="confirm-password" name="Input.ConfirmPassword" type="password" autocomplete="new-password" maxlength="1024" required />
            </div>
            <button type="submit" class="button full-width">@UiText.T("Account.ResetPassword.Submit", "更新密碼")</button>
        </EditForm>
    }
</section>

@code {
    /// <summary>重設權杖與使用者識別由查詢字串帶入，POST 時仍需與表單內容一致。</summary>
    [SupplyParameterFromQuery(Name = "user")] public string? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    [SupplyParameterFromForm(FormName = "account-reset-password")]
    private InputModel Input { get; set; } = default!;

    private bool completed;
    private string? errorMessage;

    public static class ValidationText
    {
        public static string EmailRequired => UiText.T("Account.ResetPassword.EmailRequired", "請輸入電子郵件。");
        public static string EmailInvalid => UiText.T("Account.ResetPassword.EmailInvalid", "電子郵件格式不正確。");
        public static string EmailTooLong => UiText.T("Account.ResetPassword.EmailTooLong", "電子郵件過長。");
        public static string PasswordRequired => UiText.T("Account.ResetPassword.PasswordRequired", "請輸入新密碼。");
        public static string ConfirmPasswordRequired => UiText.T("Account.ResetPassword.ConfirmPasswordRequired", "請再次輸入新密碼。");
        public static string PasswordTooLong => UiText.T("Account.ResetPassword.PasswordTooLong", "密碼過長。");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EmailRequired))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EmailInvalid))]
        [StringLength(256, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EmailTooLong))]
        public string Email { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.PasswordRequired))]
        [StringLength(1024, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.PasswordTooLong))]
        public string Password { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.ConfirmPasswordRequired))]
        [StringLength(1024, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.PasswordTooLong))]
        public string ConfirmPassword { get; set; } = "";
    }

    protected override void OnInitialized() => Input ??= new InputModel { Email = "" };

    private async Task ResetAsync()
    {
        errorMessage = null;
        if (Input is null || UserId is null || Token is null || Token.Length == 0)
        {
            errorMessage = UiText.T("Account.ResetPassword.InvalidLink", "重設連結無效或已過期，請重新申請。");
            return;
        }
        if (!string.Equals(Input.Password, Input.ConfirmPassword, StringComparison.Ordinal))
        {
            errorMessage = UiText.T("Account.ResetPassword.PasswordMismatch", "兩次輸入的新密碼不一致。");
            return;
        }
        var outcome = await PasswordReset.ResetAsync(UserId, Token, Input.Email, Input.Password);
        if (!outcome.Succeeded)
        {
            // 權杖過期或密碼不符規則；不對外顯示 Identity 的內部錯誤明細。
            Logger.LogWarning("密碼重設未成功：{UserId}", UserId);
            errorMessage = outcome.Message switch
            {
                "重設連結無效或已過期，請重新申請。" => UiText.T("Account.ResetPassword.InvalidLink", "重設連結無效或已過期，請重新申請。"),
                "新密碼不符合規則，請重新申請。" => UiText.T("Account.ResetPassword.InvalidPassword", "新密碼不符合規則，請重新申請。"),
                "重設連結無效或已過期，或新密碼未符合規則，請重新申請。" => UiText.T("Account.ResetPassword.ResetFailed", "重設連結無效或已過期，或新密碼未符合規則，請重新申請。"),
                _ => outcome.Message
            };
            return;
        }
        completed = true;
    }
}
