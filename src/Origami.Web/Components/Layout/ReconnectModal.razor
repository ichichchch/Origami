<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet aria-labelledby="reconnect-title" aria-describedby="reconnect-warning">
    <div class="components-reconnect-container">
        <h2 id="reconnect-title">@UiText.T("Reconnect.Title", "連線中斷")</h2>
        <div class="components-rejoining-animation" aria-hidden="true"><div></div><div></div></div>
        <p class="components-reconnect-first-attempt-visible" role="status">@UiText.T("Reconnect.Connecting", "正在重新連線至伺服器…")</p>
        <p class="components-reconnect-repeated-attempt-visible" role="status">@UiText.T("Reconnect.Countdown", "重新連線倒數（秒）：") <span id="components-seconds-to-next-attempt"></span></p>
        <p class="components-reconnect-failed-visible" role="alert">@UiText.T("Reconnect.Failed", "無法重新連線。請檢查網路後重試。")</p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">@UiText.T("Reconnect.Retry", "重新連線")</button>
        <p class="components-pause-visible">@UiText.T("Reconnect.Paused", "伺服器已暫停此工作階段。")</p>
        <p class="components-resume-failed-visible" role="alert">@UiText.T("Reconnect.ResumeFailed", "無法繼續工作階段。請重試，或重新載入頁面。")</p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">@UiText.T("Reconnect.Resume", "繼續工作階段")</button>
        <p id="reconnect-warning" class="reconnect-warning">@UiText.T("Reconnect.Warning", "未按儲存的內容尚未保存。連線恢復不代表儲存成功；若工作階段失效，頁面可能重新載入並遺失輸入。請先保留文字備份，再確認儲存狀態。")</p>
        <button type="button" id="components-reload-button">@UiText.T("Reconnect.Reload", "重新載入頁面（未儲存變更可能遺失）")</button>
    </div>
</dialog>
