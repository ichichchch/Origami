@inherits LayoutComponentBase
@inject OrigamiClient Api
@inject PublicSettingsProvider Settings
@inject AdminAccess Admin
@inject ILogger<MainLayout> Logger

<a class="skip-link" href="#main-content">@UiText.T("Layout.Main.01", "跳至主要內容")</a>
@* 投機載入：滑鼠指向同源連結時才預先渲染（conservative），並排除後台與預覽路徑；不支援的瀏覽器會忽略。 *@
<script type="speculationrules">
    {"prerender":[{"source":"document","where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":"/admin*"}},{"not":{"href_matches":"/account*"}},{"not":{"href_matches":"/preview*"}}]},"eagerness":"conservative"}]}
</script>
<div class="site-shell" style="@ThemeStyle" data-card-style="@_settings.CardStyle"
     data-color-scheme="@ResolvedScheme"
     data-show-cover="@(_settings.ShowCover ? "true" : "false")"
     data-show-byline="@(_settings.ShowByline ? "true" : "false")">
    @* 包 CSS 在前、站台自訂 CSS 在後：站台的自主權優先，自訂 CSS 可覆蓋包樣式。
       兩者皆已在 Api 投影與儲存時清理；不放入 HeadContent 是因 layout 層不輸出 head 內容。 *@
    @if (_settings.PackageTheme is { Css: { Length: > 0 } } package)
    {
        <style>@((MarkupString)package.Css)</style>
    }
    @if (!string.IsNullOrWhiteSpace(_settings.CustomCss))
    {
        <style>@((MarkupString)_settings.CustomCss)</style>
    }
    <header class="site-header">
        <a class="site-brand" href="/">
            @if (!string.IsNullOrEmpty(_settings.LogoFileName))
            {
                <img class="site-logo" src="@("/media/" + Uri.EscapeDataString(_settings.LogoFileName))" alt="" />
            }
            @_settings.Name
        </a>
        <nav class="site-nav" aria-label="@UiText.T("Layout.Main.Navigation", "網站導覽")">
            <a href="/" aria-current="@(IsCurrentNav("/") ? "page" : null)">@UiText.T("Layout.Main.02", "首頁")</a>
            @foreach (var (page, depth) in NavOrder())
            {
                var (href, external) = NavigationHref(page);
                if (href is null) continue;
                <a class="@(depth > 0 ? "nav-child" : "")" href="@href" target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)" aria-current="@(external ? null : IsCurrentNav(href) ? "page" : null)">@(depth > 0 ? "└ " : "")@(page.Title)</a>
            }
            <a href="/archives" aria-current="@(IsCurrentNav("/archives") ? "page" : null)">@UiText.T("Layout.Main.03", "歸檔")</a>
            <a href="/search" aria-current="@(IsCurrentNav("/search") ? "page" : null)">@UiText.T("Layout.Main.04", "搜尋文章")</a>
            <a href="/admin/posts" data-enhance-nav="false">@UiText.T("Layout.Main.05", "管理後台")</a>
        </nav>
    </header>
    @if (!string.IsNullOrWhiteSpace(_settings.Description))
    {
        <p class="site-description">@_settings.Description</p>
    }
    @if (_settings.MaintenanceMode && !_isMember)
    {
        <main id="main-content" class="public-main" tabindex="-1">
            <section class="empty-state panel" role="status" aria-labelledby="maintenance-title">
                <h1 id="maintenance-title">@UiText.T("Layout.Main.MaintenanceTitle", "網站正在維護中")</h1>
                <p>@(string.IsNullOrWhiteSpace(_settings.MaintenanceMessage) ? UiText.T("Layout.Main.MaintenanceDefault", "我們正在進行例行維護，請稍後再回來造訪。") : _settings.MaintenanceMessage)</p>
            </section>
        </main>
    }
    else
    {
        @if (_settings.MaintenanceMode && _isMember)
        {
            <p class="notice" role="status">@UiText.T("Layout.Main.MaintenanceAdminNotice", "維護模式目前已開啟：一般訪客會看到維護中畫面，你因具備站點權限仍可正常預覽。")</p>
        }
        @if (_sidebarWidgets.Count > 0)
        {
            <div class="layout-columns">
                <main id="main-content" class="public-main" tabindex="-1">@Body</main>
                <aside class="site-sidebar" aria-label="@UiText.T("Layout.Main.Sidebar", "側欄")">
                    @foreach (var widget in _sidebarWidgets)
                    {
                        <PublicWidget Widget="widget" />
                    }
                </aside>
            </div>
        }
        else
        {
            <main id="main-content" class="public-main" tabindex="-1">@Body</main>
        }
    }
    <footer class="site-footer">
        @if (_footerLinks.Count > 0)
        {
            <nav aria-label="@UiText.T("Layout.Main.FooterNavigation", "頁尾導覽")">
                <ul class="footer-nav">
                    @foreach (var link in _footerLinks)
                    {
                        var (href, external) = NavigationHref(link);
                        if (href is null) continue;
                        <li><a href="@href" target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)">@link.Title</a></li>
                    }
                </ul>
            </nav>
        }
        @if (_footerWidgets.Count > 0)
        {
            <div class="footer-widgets">
                @foreach (var widget in _footerWidgets)
                {
                    <PublicWidget Widget="widget" />
                }
            </div>
        }
        <span>@(string.IsNullOrWhiteSpace(_settings.FooterText) ? $"© {DateTime.UtcNow.Year} {_settings.Name}" : _settings.FooterText)</span>
        @if (!string.IsNullOrWhiteSpace(_settings.PrivacyPageSlug))
        {
            <a href="@("/pages/" + Uri.EscapeDataString(_settings.PrivacyPageSlug))">@(string.IsNullOrWhiteSpace(_settings.PrivacyPageTitle) ? UiText.T("Layout.Main.Privacy", "隱私權政策") : _settings.PrivacyPageTitle)</a>
        }
        @if (!string.IsNullOrWhiteSpace(_settings.SocialGithubUrl) || !string.IsNullOrWhiteSpace(_settings.SocialXUrl) || !string.IsNullOrWhiteSpace(_settings.SocialMastodonUrl))
        {
            <span class="footer-socials">
                @if (!string.IsNullOrWhiteSpace(_settings.SocialGithubUrl))
                {
                    <a href="@_settings.SocialGithubUrl" target="_blank" rel="noopener">GitHub</a>
                }
                @if (!string.IsNullOrWhiteSpace(_settings.SocialXUrl))
                {
                    <a href="@_settings.SocialXUrl" target="_blank" rel="noopener">X</a>
                }
                @if (!string.IsNullOrWhiteSpace(_settings.SocialMastodonUrl))
                {
                    <a href="@_settings.SocialMastodonUrl" target="_blank" rel="noopener">Mastodon</a>
                }
            </span>
        }
        <a href="/account/login" data-enhance-nav="false">@UiText.T("Layout.Main.06", "網站管理")</a>
        <LanguageSwitcher />
    </footer>
    @* 重新連線對話框放在殼層內：令牌（品牌色、明暗）隨殼層解析，而非 :root 預設值。 *@
    <ReconnectModal />
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private PublicSiteSettings _settings = PublicSiteSettings.Default;
    private List<PageNavItem> _pages = [];
    private List<PageNavItem> _footerLinks = [];
    private List<WidgetService.PublicWidget> _sidebarWidgets = [];
    private List<WidgetService.PublicWidget> _footerWidgets = [];
    private bool _isMember;

    /// <summary>導覽當前頁指示：以請求路徑（已解碼、去尾斜線）比對導覽href（解碼後）；
    /// 僅供輔助呈現與 aria-current，不具授權意義。</summary>
    private static bool IsExternalUrl(string? url) => url is { Length: > 0 }
        && Uri.TryCreate(url, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https" && uri.Host.Length > 0;

    private (string? Href, bool External) NavigationHref(PageNavItem page)
    {
        var external = page.IsExternal || IsExternalUrl(page.Url);
        if (external) return (page.Url, true);
        if (page.Url is { Length: > 0 } url)
        {
            var internalUrl = url[0] == '/' && (url.Length == 1 || (url[1] != '/' && url[1] != '\\'));
            return (internalUrl ? url : null, false);
        }
        return (PageHref(page), false);
    }

    private bool IsCurrentNav(string href)
    {
        if (!href.StartsWith('/')) return false;
        var path = HttpContext?.Request.Path.Value?.TrimEnd('/') ?? "";
        return string.Equals(path, Uri.UnescapeDataString(href).TrimEnd('/'), StringComparison.Ordinal);
    }

    /// <summary>帶深度的平面排序：子頁面跟在父頁面之後；若父頁面不在已發布集合內，
    /// 子頁面改以頂層呈現而不會直接消失。</summary>
    private List<(PageNavItem Page, int Depth)> NavOrder()
    {
        var byId = _pages.ToDictionary(x => x.Id);
        var customNavigation = _pages.Any(x => x.Url is { Length: > 0 });
        var children = _pages.Where(x => x.ParentId is not null && byId.ContainsKey(x.ParentId.Value))
            .ToLookup(x => x.ParentId!.Value);
        List<(PageNavItem, int)> ordered = [];
        void Walk(PageNavItem page, int depth)
        {
            ordered.Add((page, depth));
            var orderedChildren = customNavigation
                ? children[page.Id]
                : children[page.Id].OrderBy(c => c.Title).ThenBy(c => c.Id);
            foreach (var child in orderedChildren) Walk(child, depth + 1);
        }
        foreach (var top in _pages.Where(x => x.ParentId is null || !byId.ContainsKey(x.ParentId.Value)))
            Walk(top, 0);
        return ordered;
    }

    /// <summary>頁面的完整階層網址；父頁面未發布或私密時退回平面網址（與公開路由一致）。</summary>
    private string PageHref(PageNavItem page)
    {
        var byId = _pages.ToDictionary(x => x.Id);
        var parts = new List<string>();
        Guid? cursor = page.Id;
        var guard = 0;
        while (cursor is { } current && byId.TryGetValue(current, out var node) && ++guard <= 10)
        {
            parts.Insert(0, Uri.EscapeDataString(node.Slug));
            cursor = node.ParentId;
        }
        return "/pages/" + string.Join("/", parts);
    }

    /// <summary>受控版型的樣式變數：品牌基色（--accent-base）與版面變數；
    /// 現行主題包的字體與密度來自公開投影（白名單解析後的內建常數），否則退內建預設。</summary>
    private string ThemeStyle => _settings.PackageTheme is { } package
        ? ThemePresets.StyleVariables(_settings.AccentColor, _settings.ReadingWidth,
            package.FontBody, package.FontHeading, package.ProseLine, package.ListGap, package.HeadingScale)
        : ThemePresets.StyleVariables(_settings.AccentColor, _settings.ReadingWidth, _settings.ThemePreset);

    /// <summary>站台設為 auto 時跟隨訪客系統；後台外觀切換寫入的 cookie 是訪客的明確意願，優先於系統探測。</summary>
    private string ResolvedScheme
    {
        get
        {
            if (_settings.ColorScheme != ThemePresets.ColorSchemeAuto) return _settings.ColorScheme;
            var preference = HttpContext?.Request.Cookies[ThemePresets.ThemeCookieName];
            return ThemePresets.IsValidColorScheme(preference) ? preference! : ThemePresets.ColorSchemeAuto;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var ct = HttpContext?.RequestAborted ?? default;
            _settings = await Settings.GetAsync(ct);
            _pages = await Api.GetNavigationAsync(ct) ?? [];
            var widgets = await Api.GetWidgetsAsync(ct) ?? [];
            _sidebarWidgets = [.. widgets.Where(x => x.Area == WidgetArea.Sidebar)];
            _footerWidgets = [.. widgets.Where(x => x.Area == WidgetArea.Footer)];
            if (_settings.MaintenanceMode)
            {
                _isMember = await Admin.IsAdminAsync(ct);
                if (!_isMember && HttpContext?.Response.HasStarted == false)
                    HttpContext.Response.StatusCode = StatusCodes.Status503ServiceUnavailable;
            }
        }
        catch (OperationCanceledException) when (HttpContext?.RequestAborted.IsCancellationRequested == true) { /* 訪客在渲染途中已斷線；無須處理。 */ }
        catch (Exception ex) { Logger.LogError(ex, "Public navigation unavailable"); }
    }
}
