@inherits LayoutComponentBase
@inject OrigamiClient Api
@inject ILogger<MainLayout> Logger

<a class="skip-link" href="#main-content">跳至主要內容</a>
<div class="site-shell">
    <header class="site-header">
        <a class="site-brand" href="/">@_settings.Name</a>
        <nav class="site-nav" aria-label="網站導覽">
            <a href="/">首頁</a>
            @foreach (var (page, depth) in NavOrder())
            {
                <a class="@(depth > 0 ? "nav-child" : "")" href="@PageHref(page)">@(depth > 0 ? "└ " : "")@(page.Title)</a>
            }
            <a href="/archives">歸檔</a>
            <a href="/search">搜尋文章</a>
            <a href="/admin/posts" data-enhance-nav="false">管理後台</a>
        </nav>
    </header>
    @if (!string.IsNullOrWhiteSpace(_settings.Description))
    {
        <p class="site-description">@_settings.Description</p>
    }
    <main id="main-content" class="public-main" tabindex="-1">@Body</main>
    <footer class="site-footer">
        <span>© @DateTime.UtcNow.Year @_settings.Name</span>
        <a href="/account/login" data-enhance-nav="false">網站管理</a>
    </footer>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private PublicSiteSettings _settings = PublicSiteSettings.Default;
    private List<PageNavItem> _pages = [];

    /// <summary>帶深度的平面排序：子頁面跟在父頁面之後；若父頁面不在已發布集合內，
    /// 子頁面改以頂層呈現而不會直接消失。</summary>
    private List<(PageNavItem Page, int Depth)> NavOrder()
    {
        var byId = _pages.ToDictionary(x => x.Id);
        var children = _pages.Where(x => x.ParentId is not null && byId.ContainsKey(x.ParentId.Value))
            .ToLookup(x => x.ParentId!.Value);
        List<(PageNavItem, int)> ordered = [];
        void Walk(PageNavItem page, int depth)
        {
            ordered.Add((page, depth));
            foreach (var child in children[page.Id].OrderBy(c => c.Title).ThenBy(c => c.Id)) Walk(child, depth + 1);
        }
        foreach (var top in _pages.Where(x => x.ParentId is null || !byId.ContainsKey(x.ParentId.Value)))
            Walk(top, 0);
        return ordered;
    }

    /// <summary>頁面的完整階層網址；父頁面未發布或私密時退回平面網址（與公開路由一致）。</summary>
    private string PageHref(PageNavItem page)
    {
        var byId = _pages.ToDictionary(x => x.Id);
        var parts = new List<string>();
        Guid? cursor = page.Id;
        var guard = 0;
        while (cursor is { } current && byId.TryGetValue(current, out var node) && ++guard <= 10)
        {
            parts.Insert(0, Uri.EscapeDataString(node.Slug));
            cursor = node.ParentId;
        }
        return "/pages/" + string.Join("/", parts);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var ct = HttpContext?.RequestAborted ?? default;
            _settings = await Api.GetPublicSettingsAsync(ct) ?? _settings;
            _pages = await Api.GetNavigationAsync(ct) ?? [];
        }
        catch (OperationCanceledException) when (HttpContext?.RequestAborted.IsCancellationRequested == true) { /* 訪客在渲染途中已斷線；無須處理。 */ }
        catch (Exception ex) { Logger.LogError(ex, "Public navigation unavailable"); }
    }
}
