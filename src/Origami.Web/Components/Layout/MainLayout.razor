@inherits LayoutComponentBase
@inject OrigamiClient Api
@inject AdminAccess Admin
@inject ILogger<MainLayout> Logger

<a class="skip-link" href="#main-content">@UiText.T("Layout.Main.01", "跳至主要內容")</a>
<div class="site-shell" style="@ThemeStyle" data-card-style="@_settings.CardStyle"
     data-color-scheme="@ResolvedScheme"
     data-show-cover="@(_settings.ShowCover ? "true" : "false")"
     data-show-byline="@(_settings.ShowByline ? "true" : "false")">
    <header class="site-header">
        <a class="site-brand" href="/">
            @if (!string.IsNullOrEmpty(_settings.LogoFileName))
            {
                <img class="site-logo" src="@("/media/" + Uri.EscapeDataString(_settings.LogoFileName))" alt="" />
            }
            @_settings.Name
        </a>
        <nav class="site-nav" aria-label="@UiText.T("Layout.Main.Navigation", "網站導覽")">
            <a href="/">@UiText.T("Layout.Main.02", "首頁")</a>
            @foreach (var (page, depth) in NavOrder())
            {
                // 自訂導覽項目自帶網址；頁面項目仍依階層網址。
                var href = page.Url ?? PageHref(page);
                <a class="@(depth > 0 ? "nav-child" : "")" href="@href" target="@(page.IsExternal ? "_blank" : null)" rel="@(page.IsExternal ? "noopener" : null)">@(depth > 0 ? "└ " : "")@(page.Title)</a>
            }
            <a href="/archives">@UiText.T("Layout.Main.03", "歸檔")</a>
            <a href="/search">@UiText.T("Layout.Main.04", "搜尋文章")</a>
            <a href="/admin/posts" data-enhance-nav="false">@UiText.T("Layout.Main.05", "管理後台")</a>
        </nav>
    </header>
    @if (!string.IsNullOrWhiteSpace(_settings.Description))
    {
        <p class="site-description">@_settings.Description</p>
    }
    @if (_settings.MaintenanceMode && !_isMember)
    {
        <main id="main-content" class="public-main" tabindex="-1">
            <section class="empty-state panel" role="status" aria-labelledby="maintenance-title">
                <h1 id="maintenance-title">@UiText.T("Layout.Main.MaintenanceTitle", "網站正在維護中")</h1>
                <p>@(string.IsNullOrWhiteSpace(_settings.MaintenanceMessage) ? UiText.T("Layout.Main.MaintenanceDefault", "我們正在進行例行維護，請稍後再回來造訪。") : _settings.MaintenanceMessage)</p>
            </section>
        </main>
    }
    else
    {
        @if (_settings.MaintenanceMode && _isMember)
        {
            <p class="notice" role="status">@UiText.T("Layout.Main.MaintenanceAdminNotice", "維護模式目前已開啟：一般訪客會看到維護中畫面，你因具備站點權限仍可正常預覽。")</p>
        }
        <main id="main-content" class="public-main" tabindex="-1">@Body</main>
    }
    <footer class="site-footer">
        <span>@(string.IsNullOrWhiteSpace(_settings.FooterText) ? $"© {DateTime.UtcNow.Year} {_settings.Name}" : _settings.FooterText)</span>
        @if (!string.IsNullOrWhiteSpace(_settings.PrivacyPageSlug))
        {
            <a href="@("/pages/" + Uri.EscapeDataString(_settings.PrivacyPageSlug))">@(string.IsNullOrWhiteSpace(_settings.PrivacyPageTitle) ? "隱私權政策" : _settings.PrivacyPageTitle)</a>
        }
        @if (!string.IsNullOrWhiteSpace(_settings.SocialGithubUrl) || !string.IsNullOrWhiteSpace(_settings.SocialXUrl) || !string.IsNullOrWhiteSpace(_settings.SocialMastodonUrl))
        {
            <span class="footer-socials">
                @if (!string.IsNullOrWhiteSpace(_settings.SocialGithubUrl))
                {
                    <a href="@_settings.SocialGithubUrl" target="_blank" rel="noopener">GitHub</a>
                }
                @if (!string.IsNullOrWhiteSpace(_settings.SocialXUrl))
                {
                    <a href="@_settings.SocialXUrl" target="_blank" rel="noopener">X</a>
                }
                @if (!string.IsNullOrWhiteSpace(_settings.SocialMastodonUrl))
                {
                    <a href="@_settings.SocialMastodonUrl" target="_blank" rel="noopener">Mastodon</a>
                }
            </span>
        }
        <a href="/account/login" data-enhance-nav="false">@UiText.T("Layout.Main.06", "網站管理")</a>
        <LanguageSwitcher />
    </footer>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private PublicSiteSettings _settings = PublicSiteSettings.Default;
    private List<PageNavItem> _pages = [];
    private bool _isMember;

    /// <summary>帶深度的平面排序：子頁面跟在父頁面之後；若父頁面不在已發布集合內，
    /// 子頁面改以頂層呈現而不會直接消失。</summary>
    private List<(PageNavItem Page, int Depth)> NavOrder()
    {
        var byId = _pages.ToDictionary(x => x.Id);
        var children = _pages.Where(x => x.ParentId is not null && byId.ContainsKey(x.ParentId.Value))
            .ToLookup(x => x.ParentId!.Value);
        List<(PageNavItem, int)> ordered = [];
        void Walk(PageNavItem page, int depth)
        {
            ordered.Add((page, depth));
            foreach (var child in children[page.Id].OrderBy(c => c.Title).ThenBy(c => c.Id)) Walk(child, depth + 1);
        }
        foreach (var top in _pages.Where(x => x.ParentId is null || !byId.ContainsKey(x.ParentId.Value)))
            Walk(top, 0);
        return ordered;
    }

    /// <summary>頁面的完整階層網址；父頁面未發布或私密時退回平面網址（與公開路由一致）。</summary>
    private string PageHref(PageNavItem page)
    {
        var byId = _pages.ToDictionary(x => x.Id);
        var parts = new List<string>();
        Guid? cursor = page.Id;
        var guard = 0;
        while (cursor is { } current && byId.TryGetValue(current, out var node) && ++guard <= 10)
        {
            parts.Insert(0, Uri.EscapeDataString(node.Slug));
            cursor = node.ParentId;
        }
        return "/pages/" + string.Join("/", parts);
    }

    /// <summary>受控版型的樣式變數；色碼只接受合法十六進位值，避免注入樣式。
    /// 注入的是品牌基色（--accent-base），明暗模式各自在其上派生填充與前景色。</summary>
    private string ThemeStyle
    {
        get
        {
            var color = ThemePresets.IsValidColor(_settings.AccentColor) ? _settings.AccentColor : "#2f6f4e";
            var width = ThemePresets.IsValidReadingWidth(_settings.ReadingWidth) ? _settings.ReadingWidth : 68;
            return $"--accent-base:{color};--reading-width:{width}ch";
        }
    }

    /// <summary>站台設為 auto 時跟隨訪客系統；後台外觀切換寫入的 cookie 是訪客的明確意願，優先於系統探測。</summary>
    private string ResolvedScheme
    {
        get
        {
            if (_settings.ColorScheme != ThemePresets.ColorSchemeAuto) return _settings.ColorScheme;
            var preference = HttpContext?.Request.Cookies[ThemePresets.ThemeCookieName];
            return ThemePresets.IsValidColorScheme(preference) ? preference! : ThemePresets.ColorSchemeAuto;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var ct = HttpContext?.RequestAborted ?? default;
            _settings = await Api.GetPublicSettingsAsync(ct) ?? _settings;
            _pages = await Api.GetNavigationAsync(ct) ?? [];
            if (_settings.MaintenanceMode)
            {
                _isMember = await Admin.IsAdminAsync(ct);
                if (!_isMember && HttpContext?.Response.HasStarted == false)
                    HttpContext.Response.StatusCode = StatusCodes.Status503ServiceUnavailable;
            }
        }
        catch (OperationCanceledException) when (HttpContext?.RequestAborted.IsCancellationRequested == true) { /* 訪客在渲染途中已斷線；無須處理。 */ }
        catch (Exception ex) { Logger.LogError(ex, "Public navigation unavailable"); }
    }
}
