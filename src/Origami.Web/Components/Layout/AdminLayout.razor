@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject OrigamiClient AccessApi

<a class="skip-link" href="#main-content">@UiText.T("Layout.Main.01", "跳至主要內容")</a>
@* 各頁面的互動島嶼無法攔截 Static SSR 連結的增強導覽。
   後台採整份文件導覽，讓 NavigationLock 得以保護未儲存的輸入。 *@
<div class="admin-shell" data-enhance-nav="false" data-color-scheme="@_scheme">
    <aside class="admin-sidebar">
        <a class="admin-brand" href="/admin"><span class="brand-mark" aria-hidden="true"><span class="brand-cube"><i></i><i></i><i></i><i></i><i></i><i></i></span></span><span>Origami<small>@UiText.T("Layout.Admin.ContentManagement", "內容管理")</small></span></a>
        <nav class="admin-nav" aria-label="@UiText.T("Layout.Admin.Navigation", "後台導覽")">
            <span class="nav-label">@UiText.T("Layout.Admin.Workspace", "工作空間")</span>
            <NavLink href="/admin" Match="NavLinkMatch.All">@UiText.T("Layout.Admin.Dashboard", "總覽儀表板")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/posts">@UiText.T("Layout.Admin.Posts", "文章")@if (_pendingContents > 0) { <span class="nav-badge" aria-label="@string.Format(CultureInfo.CurrentCulture, UiText.T("Layout.Admin.PendingContentsBadge", "{0} 筆待審稿"), _pendingContents)">@_pendingContents</span> } else { <span aria-hidden="true">↗</span> }</NavLink>
            <NavLink href="/admin/pages">@UiText.T("Layout.Admin.Pages", "獨立頁面")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/taxonomies">@UiText.T("Layout.Admin.Taxonomies", "分類與標籤")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/types">@UiText.T("Layout.Admin.ContentTypes", "內容類型")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/templates">@UiText.T("Layout.Admin.Templates", "範本與片段")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/navigation">@UiText.T("Layout.Main.Navigation", "網站導覽")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/widgets">@UiText.T("Layout.Admin.Widgets", "側欄與頁尾小工具")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/marketplace">@UiText.T("Layout.Admin.Marketplace", "主題與小工具包")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/comments">@UiText.T("Layout.Admin.Comments", "評論")@if (_pendingComments > 0) { <span class="nav-badge" aria-label="@string.Format(CultureInfo.CurrentCulture, UiText.T("Layout.Admin.PendingCommentsBadge", "{0} 則待審評論"), _pendingComments)">@_pendingComments</span> } else { <span aria-hidden="true">↗</span> }</NavLink>
            <NavLink href="/admin/media">@UiText.T("Layout.Admin.Media", "媒體庫")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/redirects">@UiText.T("Layout.Admin.Redirects", "301 重定向")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/settings">@UiText.T("Layout.Admin.Settings", "網站設定")<span aria-hidden="true">↗</span></NavLink>
            @* 連結顯示只是導覽體驗；各頁與 API 仍逐一重驗角色。 *@
            @if (_access?.CanAdminister == true)
            {
                <NavLink href="/admin/members">@UiText.T("Layout.Admin.Members", "站點成員")</NavLink>
                <NavLink href="/admin/audit">@UiText.T("Layout.Admin.AuditLogs", "審計日誌")</NavLink>
                <NavLink href="/admin/site-health">@UiText.T("Layout.Admin.SiteHealth", "系統健康與 Webhook")</NavLink>
            }
            @if (_access?.CanRead == true)
            {
                <NavLink href="/admin/sites">@UiText.T("Layout.Admin.Sites", "站點 / 切換站點")</NavLink>
                <NavLink href="/admin/credentials">@UiText.T("Layout.Admin.Credentials", "我的 API 憑證")</NavLink>
            }
            @if (_access?.IsNetworkAdmin == true)
            {
                <NavLink href="/admin/users">@UiText.T("Layout.Admin.Users", "使用者（全站管理）")</NavLink>
            }
            <NavLink href="/admin/security">@UiText.T("Layout.Admin.Security", "安全設定")<span aria-hidden="true">↗</span></NavLink>
            <NavLink href="/admin/assistant">@UiText.T("Layout.Admin.Assistant", "AI 助理")<span aria-hidden="true">↗</span></NavLink>
        </nav>
        <div class="sidebar-bottom">
            <a href="/" data-enhance-nav="false">@UiText.T("Layout.Admin.ViewSite", "檢視公開網站 ↗")</a>
            <button type="button" class="theme-toggle" data-theme-toggle data-scheme="@_scheme"
                    data-label-auto="@UiText.T("Layout.Admin.ThemeAuto", "外觀：跟隨系統")"
                    data-label-light="@UiText.T("Layout.Admin.ThemeLight", "外觀：淺色")"
                    data-label-dark="@UiText.T("Layout.Admin.ThemeDark", "外觀：深色")"
                    aria-label="@UiText.T("Layout.Admin.ThemeToggle", "切換後台外觀（跟隨系統／淺色／深色）")">@SchemeLabel(_scheme)</button>
            <form method="post" action="/account/logout" data-enhance="false">
                <AntiforgeryToken />
                <button type="submit" class="logout-button">@UiText.T("Layout.Admin.SignOut", "登出")</button>
            </form>
            <LanguageSwitcher />
        </div>
    </aside>
    <div class="admin-workspace">
        <header class="admin-topbar">
            <span>@(new Uri(Navigation.Uri).Authority)</span>
            <span class="workspace-label">@UiText.T("Layout.Admin.Access", "網站後台 · 權限依站點而定")</span>
            @* 命令面板入口：靜態渲染的按鈕由 admin-palette.js 接管（Ctrl／Cmd + K 亦可開啟）。 *@
            <button type="button" class="palette-trigger" id="admin-palette-trigger" aria-haspopup="dialog" aria-controls="admin-palette" title="@UiText.T("Layout.Admin.PaletteHint", "快速前往（Ctrl／Cmd + K）")">@UiText.T("Layout.Admin.Palette", "快速前往")</button>
        </header>
        <main id="main-content" class="admin-main" tabindex="-1">@Body</main>
        <footer class="admin-footer">@UiText.T("Layout.Admin.Footer", "專注內容，從這裡開始。")</footer>
    </div>
    @* 對話框與錯誤條放在殼層內：黑白與深色令牌隨 .admin-shell 解析，深色後台不再露出淺色面板。 *@
    <ReconnectModal />
    @* 命令面板：導覽項目依目前角色靜態輸出（JSON 以 MarkupString 內嵌，序列化器已把 &lt; 與 &amp; 轉義，無法提前結束 script）。 *@
    <script type="application/json" id="admin-palette-items">@((MarkupString)PaletteItemsJson)</script>
    <div class="palette" id="admin-palette" role="dialog" aria-modal="true" aria-label="@UiText.T("Layout.Admin.Palette", "快速前往")" data-empty="@UiText.T("Layout.Admin.PaletteEmpty", "沒有符合的項目")" hidden>
        <div class="palette-box">
            <div class="palette-head">
                <input class="palette-input" type="text" role="combobox" aria-expanded="true" aria-controls="admin-palette-list" aria-autocomplete="list" aria-label="@UiText.T("Layout.Admin.PalettePlaceholder", "搜尋頁面或內容")" placeholder="@UiText.T("Layout.Admin.PalettePlaceholder", "搜尋頁面或內容")" maxlength="200" autocomplete="off" />
                <button type="button" class="palette-close" aria-label="@UiText.T("Layout.Admin.PaletteClose", "關閉")">×</button>
            </div>
            <ul class="palette-list" id="admin-palette-list" role="listbox" aria-label="@UiText.T("Layout.Admin.PaletteResults", "結果")"></ul>
            <p class="palette-status" role="status"></p>
            <p class="palette-help">@UiText.T("Layout.Admin.PaletteHelp", "↑↓ 選擇 · Enter 開啟 · Esc 關閉；輸入兩個字以上會同時搜尋文章與頁面")</p>
        </div>
    </div>
    <div id="blazor-error-ui" role="alert" data-nosnippet>
        @UiText.T("Layout.Admin.Error", "介面發生錯誤。未儲存的變更可能遺失，請先複製輸入再重新載入。")
        <a href="" class="reload">@UiText.T("Common.Reload", "重新載入")</a>
        <button type="button" class="dismiss" aria-label="@UiText.T("Layout.Admin.DismissError", "關閉錯誤提示")">×</button>
    </div>
</div>

@code {
    private SiteAccessInfo? _access;
    private string _scheme = ThemePresets.ColorSchemeAuto;
    private int _pendingContents;
    private int _pendingComments;

    /// <summary>命令面板的靜態導覽項目：只列出目前角色可用的頁面（各頁仍會自行重驗角色）。</summary>
    private string PaletteItemsJson
    {
        get
        {
            var access = _access;
            List<(string Title, string Url, string Kind)> items =
            [
                (UiText.T("Layout.Admin.Dashboard", "總覽儀表板"), "/admin", UiText.T("Layout.Admin.PaletteKindPage", "頁面")),
                (UiText.T("Layout.Admin.Posts", "文章"), "/admin/posts", UiText.T("Layout.Admin.PaletteKindPage", "頁面")),
                (UiText.T("Layout.Admin.Pages", "獨立頁面"), "/admin/pages", UiText.T("Layout.Admin.PaletteKindPage", "頁面"))
            ];
            if (access?.CanEdit == true)
            {
                items.Add((UiText.T("Admin.Dashboard.NewPost", "撰寫新文章"), "/admin/posts/new", UiText.T("Layout.Admin.PaletteKindAction", "動作")));
                items.Add((UiText.T("Layout.Admin.Taxonomies", "分類與標籤"), "/admin/taxonomies", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
                items.Add((UiText.T("Layout.Admin.Templates", "範本與片段"), "/admin/templates", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
                items.Add((UiText.T("Layout.Admin.Media", "媒體庫"), "/admin/media", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
                items.Add((UiText.T("Layout.Main.Navigation", "網站導覽"), "/admin/navigation", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
                items.Add((UiText.T("Layout.Admin.Widgets", "側欄與頁尾小工具"), "/admin/widgets", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
            }
            items.Add((UiText.T("Layout.Admin.Comments", "評論"), "/admin/comments", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
            items.Add((UiText.T("Layout.Admin.ContentTypes", "內容類型"), "/admin/types", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
            items.Add((UiText.T("Layout.Admin.Marketplace", "主題與小工具包"), "/admin/marketplace", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
            if (access?.CanAdminister == true)
            {
                items.Add((UiText.T("Layout.Admin.Redirects", "301 重定向"), "/admin/redirects", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
                items.Add((UiText.T("Layout.Admin.Settings", "網站設定"), "/admin/settings", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
                items.Add((UiText.T("Layout.Admin.SiteHealth", "系統健康與 Webhook"), "/admin/site-health", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
                items.Add((UiText.T("Layout.Admin.Assistant", "AI 助理"), "/admin/assistant", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
            }
            if (access?.IsNetworkAdmin == true)
            {
                items.Add((UiText.T("Layout.Admin.Sites", "站點 / 切換站點"), "/admin/sites", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
                items.Add((UiText.T("Layout.Admin.Users", "使用者（全站管理）"), "/admin/users", UiText.T("Layout.Admin.PaletteKindPage", "頁面")));
            }
            return System.Text.Json.JsonSerializer.Serialize(items.Select(x => new { x.Title, x.Url, x.Kind }),
                new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
        }
    }

    // 後台外觀偏好：讀 cookie 由服務端渲染 data-color-scheme，避免載入閃爍；
    // 切換由 theme.js 就地循環 auto→light→dark 並回寫 cookie。
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private static string SchemeLabel(string scheme) => scheme switch
    {
        ThemePresets.ColorSchemeLight => UiText.T("Layout.Admin.ThemeLight", "外觀：淺色"),
        ThemePresets.ColorSchemeDark => UiText.T("Layout.Admin.ThemeDark", "外觀：深色"),
        _ => UiText.T("Layout.Admin.ThemeAuto", "外觀：跟隨系統"),
    };

    protected override void OnInitialized()
    {
        var preference = HttpContext?.Request.Cookies[ThemePresets.ThemeCookieName];
        _scheme = ThemePresets.IsValidColorScheme(preference) ? preference! : ThemePresets.ColorSchemeAuto;
    }

    // 僅供導覽顯示；取得失敗（未登入或服務暫停）時隱藏角色相關連結，不阻擋頁面本身。
    protected override async Task OnInitializedAsync()
    {
        try { _access = await AccessApi.GetAccessAsync(); }
        catch { _access = null; }
        await RefreshCountsAsync();
        // 版面在互動電路內時，每次導覽後重新取得待審數；靜態渲染則隨每次請求重新計算。
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = RefreshCountsAsync();

    /// <summary>側欄待審角章（待審稿與待審評論）；只是提示，失敗時不顯示也不影響頁面。</summary>
    private async Task RefreshCountsAsync()
    {
        if (_access?.CanRead != true) return;
        try
        {
            var counts = await AccessApi.CountAdminAsync(ContentKind.Post);
            var comments = await AccessApi.GetCommentCountsAsync();
            _pendingContents = counts?.Pending ?? 0;
            _pendingComments = comments?.Pending ?? 0;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // 預渲染期間沒有 JS 執行階段或服務暫停：維持原狀。
        }
    }
}
