@page "/admin/media"
@rendermode InteractiveServer
@attribute [Authorize]
@layout AdminLayout
@inherits AdminComponentBase
@inject OrigamiClient Api

<PageTitle>媒體庫 · 內容管理</PageTitle>
<UnsavedGuard Busy="Busy" />
<div class="page-heading"><div><p class="eyebrow">用圖片說故事</p><h1>媒體庫</h1><p>上傳圖片，隨時在文章或頁面中使用。</p></div></div>
<p class="notice privacy-notice"><strong>圖片一律公開。</strong>所有上傳圖片（包含草稿中的圖片）都可透過網址存取。撤回或刪除內容不會隱藏圖片，請勿上傳私人資料。</p>
<AdminFeedback Busy="Busy" Error="@Error" Notice="@Notice" LoginRequired="LoginRequired" />
@if (Access?.CanRead == true && !CanEdit)
{
    <p class="notice">本站唯讀成員可瀏覽圖片，但不能上傳、修改或刪除。</p>
}
<section class="panel upload-panel">
    <div><h2>上傳新圖片</h2><p>選取後即上傳。每次一張，單張上限 @(Limits.UploadBytes / 1024 / 1024) MB。</p><p class="field-help">支援 JPEG、PNG、WebP（不含動畫）；實際格式與圖片大小由伺服器驗證。不接受 SVG。</p></div>
    <div class="upload-control"><label for="media-upload" class="sr-only">選取要上傳的圖片</label><InputFile id="media-upload" OnChange="Upload" accept="image/jpeg,image/png,image/webp" disabled="@EditBlocked" />@if (_uploadName is not null) { <p role="status">正在上傳：@_uploadName</p> }</div>
</section>
@if (_uploaded is not null)
{
    <section class="notice notice-success"><p>最近上傳：<strong>@_uploaded.OriginalName</strong></p><p>在編輯器點選「插入圖片」，或複製下方 Markdown：</p><label class="sr-only" for="uploaded-markdown">最近上傳圖片的 Markdown</label><input id="uploaded-markdown" class="code-input" value="@_uploaded.Markdown" readonly /></section>
}
@if (Error is not null && !LoginRequired) { <button class="button button-secondary" disabled="@Blocked" @onclick="Load">重新載入媒體列表</button> }
@if (_pendingDelete is not null)
{
    <section class="notice notice-danger" role="alertdialog" aria-labelledby="media-delete-title" aria-describedby="media-delete-description">
        <h2 id="media-delete-title">刪除圖片「@_pendingDelete.OriginalName」？</h2>
        @if (_pendingReferences.Count > 0)
        {
            <p id="media-delete-description">這張圖片仍被以下內容引用，需先移除引用才能刪除：</p>
            <ul>
                @foreach (var reference in _pendingReferences)
                {
                    <li>「@reference.Title」（@(reference.Status switch { ContentStatus.Published => "已發布", ContentStatus.Trashed => "回收桶", _ => "草稿" })）</li>
                }
            </ul>
        }
        else
        {
            <p id="media-delete-description">沒有任何內容引用這張圖片。刪除後圖片網址立即失效，無法復原（含縮圖變體）。</p>
        }
        <div class="button-row">
            <button class="button button-danger" disabled="@(EditBlocked || _pendingReferences.Count > 0)" @onclick="DeleteAsync">確認刪除圖片</button>
            <button class="button button-secondary" disabled="@EditBlocked" @onclick="() => _pendingDelete = null">取消</button>
        </div>
    </section>
}
<section class="panel media-library" aria-busy="@Busy.ToString().ToLowerInvariant()">
    <div class="panel-toolbar"><h2>所有圖片 <span class="count">@(_result?.Total ?? 0)</span></h2><span class="muted">依上傳時間排序</span></div>
    <div class="content-search">
        <label class="sr-only" for="media-search">搜尋圖片</label>
        <input id="media-search" type="search" placeholder="搜尋檔名、替代或說明文字…" maxlength="300" value="@_search" @onchange="SearchChanged" disabled="@Blocked" />
        @if (_search.Length > 0)
        {
            <button type="button" class="text-button" disabled="@Blocked" @onclick="ClearSearch">清除</button>
        }
    </div>
    @if (_result is not null)
    {
        @if (_result.Items.Count == 0)
        {
            <div class="empty-state"><span class="empty-symbol" aria-hidden="true">＋</span><h2>為文字添一點畫面</h2><p>上傳第一張圖片，開始建立媒體庫。</p></div>
        }
        else
        {
            <div class="media-grid">
            @foreach (var item in _result.Items)
            {
                <article class="media-card" @key="item.Id"><a href="@item.Url" target="_blank" rel="noopener" aria-label="@("開啟原圖：" + item.OriginalName)"><img src="@item.Url" alt="@item.AltText" loading="lazy" /></a><div class="media-details"><h3>@item.OriginalName</h3><p>@item.Width × @item.Height · @Size(item.Size)</p><p>@item.UploadedAt.ToString("yyyy.MM.dd HH:mm") UTC</p>
@if (item.ReferenceCount > 0)
{
    <p class="field-help">被 @item.ReferenceCount 篇內容引用</p>
}<label for="@("media-alt-" + item.Id)">替代文字（alt）</label><input id="@("media-alt-" + item.Id)" value="@AltValue(item)" maxlength="@Limits.AltText" @oninput="@(e => _altEdits[item.Id] = e.Value?.ToString() ?? "")" disabled="@EditBlocked" aria-describedby="@("media-alt-help-" + item.Id)" /><p id="@("media-alt-help-" + item.Id)" class="field-help">最多 @Limits.AltText 字；插入文章時自動作為圖片 alt，改善無障礙與 SEO。</p>
<label for="@("media-caption-" + item.Id)">說明文字（caption）</label><input id="@("media-caption-" + item.Id)" value="@CaptionValue(item)" maxlength="@Limits.Caption" @oninput="@(e => _captionEdits[item.Id] = e.Value?.ToString() ?? "")" disabled="@EditBlocked" aria-describedby="@("media-caption-help-" + item.Id)" /><p id="@("media-caption-help-" + item.Id)" class="field-help">最多 @Limits.Caption 字；圖片作為封面時顯示於圖片下方。</p><button type="button" class="button button-secondary button-small" disabled="@(EditBlocked || (!_altEdits.ContainsKey(item.Id) && !_captionEdits.ContainsKey(item.Id)))" @onclick="() => SaveMeta(item.Id)">儲存圖片資訊</button>
<button type="button" class="text-danger" disabled="@EditBlocked" @onclick="() => RequestDelete(item)">刪除圖片<span class="sr-only"> @item.OriginalName</span></button><label for="@("media-code-" + item.Id)">複製 Markdown</label><input id="@("media-code-" + item.Id)" class="code-input" value="@item.Markdown" readonly /></div></article>
            }
            </div>
        }
        <nav class="pagination" aria-label="媒體分頁"><button class="button button-secondary" disabled="@(Blocked || _page <= 1)" @onclick="() => Move(-1)">上一頁</button><span>@_result.Page / @_result.TotalPages</span><button class="button button-secondary" disabled="@(Blocked || _page >= _result.TotalPages)" @onclick="() => Move(1)">下一頁</button></nav>
    }
</section>

@code {
    private int _page = 1;
    private string _search = "";
    private PagedResult<MediaItem>? _result;
    private MediaItem? _uploaded;
    private string? _uploadName;
    private readonly Dictionary<Guid, string> _altEdits = [];
    private readonly Dictionary<Guid, string> _captionEdits = [];
    private MediaItem? _pendingDelete;
    private List<MediaService.MediaReference> _pendingReferences = [];
    protected override Task OnInitializedAsync() => Load();
    private string? ListSearch() => string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
    private Task<bool> Load() => RunAsync(async ct => { _result = await ListWithCountsAsync(ct); });

    // 引用數已由列表端點一次填入 MediaItem.ReferenceCount。
    private async Task<PagedResult<MediaItem>> ListWithCountsAsync(CancellationToken ct) =>
        await Api.ListMediaAsync(_page, search: ListSearch(), ct: ct)
            ?? new PagedResult<MediaItem>([], 0, _page, Limits.PageSize);
    private async Task SearchChanged(ChangeEventArgs args)
    {
        if (Blocked) return;
        _search = args.Value?.ToString() ?? "";
        _page = 1;
        await Load();
    }
    private async Task ClearSearch()
    {
        if (Blocked) return;
        _search = "";
        _page = 1;
        await Load();
    }
    private async Task RequestDelete(MediaItem item)
    {
        if (Blocked) return;
        _pendingDelete = item;
        _pendingReferences = [];
        var ok = await RunAsync(async ct => { _pendingReferences = await Api.ListMediaReferencesAsync(item.Id, ct) ?? []; });
        if (!ok) _pendingDelete = null;
    }
    private async Task DeleteAsync()
    {
        if (_pendingDelete is not { } item || Blocked) return;
        var deleted = await RunEditAsync(async ct =>
        {
            await Api.DeleteMediaAsync(item.Id, ct);
            _pendingDelete = null;
            _result = await ListWithCountsAsync(ct);
        }, "圖片已刪除（含縮圖變體）。");
        if (!deleted) _pendingDelete = null;
    }
    private string AltValue(MediaItem item) => _altEdits.TryGetValue(item.Id, out var value) ? value : item.AltText;
    private string CaptionValue(MediaItem item) => _captionEdits.TryGetValue(item.Id, out var value) ? value : item.Caption;
    private Task SaveMeta(Guid id) => RunEditAsync(async ct =>
    {
        // 未動過的欄位沿用已儲存值；只有編輯中的欄位會覆寫。
        var stored = _result?.Items.FirstOrDefault(x => x.Id == id);
        var alt = _altEdits.TryGetValue(id, out var altEdit) ? altEdit : stored?.AltText ?? "";
        var caption = _captionEdits.TryGetValue(id, out var captionEdit) ? captionEdit : stored?.Caption ?? "";
        await Api.UpdateMediaMetaAsync(id, alt, caption, ct);
        _altEdits.Remove(id);
        _captionEdits.Remove(id);
        _result = await ListWithCountsAsync(ct);
    }, "圖片資訊已儲存，替代文字會自動帶入插入語法。");
    private async Task Move(int delta)
    {
        if (Blocked) return;
        var previousPage = _page;
        _page += delta;
        if (!await Load()) _page = previousPage;
    }
    private async Task Upload(InputFileChangeEventArgs args)
    {
        if (EditBlocked) return;
        await RunEditAsync(async ct =>
        {
            var file = args.File;
            if (file.Size > Limits.UploadBytes) throw new CmsException($"圖片超過 {Limits.UploadBytes / 1024 / 1024} MB 上限，請選擇較小的檔案。");
            _uploadName = file.Name;
            await using var stream = file.OpenReadStream(Limits.UploadBytes, ct);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer, ct);
            _uploaded = await Api.UploadMediaAsync(buffer.ToArray(), file.Name, ct);
            _page = 1;
            _result = await ListWithCountsAsync(ct);
        }, "圖片已上傳，現在可在編輯器中插入。");
        _uploadName = null;
    }
    private static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.##} MB" : $"{bytes / 1024d:0.#} KB";
}
