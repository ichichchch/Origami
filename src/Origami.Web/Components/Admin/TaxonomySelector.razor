@inherits AdminComponentBase
@inject TaxonomyService Taxonomies

<section class="taxonomy-selector" aria-label="@(Label)">
    <div class="panel-toolbar compact"><h3>@(Label)</h3><span class="muted">已選 @Selected.Count / @Limits.MaxTaxonomiesPerKind</span></div>
    <p class="field-help">可複選；換頁或刷新不會清除已選項目。</p>
    <AdminFeedback Busy="Busy" Error="@Error" Notice="@Notice" LoginRequired="LoginRequired" />
    <fieldset disabled="@(Disabled || Blocked)">
        <div class="field">
            <label for="@NameInputId">新增@(Label)名稱</label>
            @* 不得隱含送出所在的 EditForm，也不得將 IME 確認視為建立。 *@
            <input id="@NameInputId" @bind="_newName" @bind:event="oninput" maxlength="@Limits.TaxonomyName" disabled="@AtLimit" onkeydown="if (event.key === 'Enter' && !event.isComposing) event.preventDefault();" />
            <span class="field-help">最多 @Limits.TaxonomyName 字；建立後自動選取，不會儲存本文。</span>
        </div>
        <div class="button-row">
            <button type="button" class="button button-secondary button-small" disabled="@(AtLimit || string.IsNullOrWhiteSpace(_newName))" @onclick="Create">建立並選取@(Label)</button>
            <button type="button" class="text-button" @onclick="Refresh">刷新@(Label)</button>
        </div>
        @if (AtLimit) { <p class="field-help" role="status">已達 @Limits.MaxTaxonomiesPerKind 個@(Label)上限，請先取消選取。</p> }
        @if (_created is not null && (_result is null || !_result.Items.Any(item => item.Id == _created.Id)))
        {
            <div class="checkbox-list"><label><input type="checkbox" checked="@Selected.Contains(_created.Id)" disabled="@(AtLimit && !Selected.Contains(_created.Id))" @onchange="e => Toggle(_created.Id, e.Value is true)" /> @_created.Name（剛建立）</label></div>
        }
        @if (_result is not null)
        {
            @if (_result.Items.Count == 0 && _created is null) { <p class="muted">尚未建立@(Label)。</p> }
            <div class="checkbox-list">
            @foreach (var item in _result.Items)
            {
                <label @key="item.Id"><input type="checkbox" checked="@Selected.Contains(item.Id)" disabled="@(AtLimit && !Selected.Contains(item.Id))" @onchange="e => Toggle(item.Id, e.Value is true)" /> @item.Name</label>
            }
            </div>
            @if (_result.TotalPages > 1)
            {
                <div class="pagination compact"><button type="button" class="button button-secondary" disabled="@(_page <= 1)" @onclick="() => Move(-1)">上一頁</button><span>@_result.Page / @_result.TotalPages</span><button type="button" class="button button-secondary" disabled="@(_page >= _result.TotalPages)" @onclick="() => Move(1)">下一頁</button></div>
            }
        }
        @if (Selected.Count > 0) { <button type="button" class="text-button" @onclick="Clear">清除全部已選@(Label)</button> }
    </fieldset>
</section>

@code {
    [Parameter] public TaxonomyKind Kind { get; set; }
    [Parameter, EditorRequired] public List<Guid> Selected { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    [Parameter] public EventCallback OnUnauthorized { get; set; }
    private string Label => Kind == TaxonomyKind.Category ? "分類" : "標籤";
    private string NameInputId => "new-taxonomy-" + Kind;
    private bool AtLimit => Selected.Count >= Limits.MaxTaxonomiesPerKind;
    private string _newName = "";
    private TaxonomyItem? _created;
    private int _page = 1;
    private PagedResult<TaxonomyItem>? _result;
    protected override Task OnInitializedAsync() => Load();
    private Task<bool> Load() => RunOperationAsync(LoadOptions);
    private async Task LoadOptions(CancellationToken ct)
    {
        var result = await Taxonomies.ListAsync(Kind, _page, Limits.MaxPageSize, ct);
        if (_page > result.TotalPages)
            result = await Taxonomies.ListAsync(Kind, result.TotalPages, Limits.MaxPageSize, ct);
        _page = result.Page;
        _result = result;
    }
    private async Task Refresh()
    {
        if (Disabled || Blocked) return;
        await Load();
    }
    private async Task<bool> RunOperationAsync(Func<CancellationToken, Task> action, string? success = null)
    {
        var started = false;
        try
        {
            return await RunAsync(async ct =>
            {
                started = true;
                await BusyChanged.InvokeAsync(true);
                await action(ct);
            }, success);
        }
        finally
        {
            if (started) await BusyChanged.InvokeAsync(false);
            if (LoginRequired) await OnUnauthorized.InvokeAsync();
        }
    }
    private async Task Create()
    {
        if (Disabled || Blocked) return;
        await RunOperationAsync(async ct =>
        {
            if (AtLimit) throw new CmsException($"每篇文章最多 {Limits.MaxTaxonomiesPerKind} 個{Label}，請先取消選取。");
            TaxonomyEdit saved;
            try { saved = await Taxonomies.SaveAsync(Kind, new TaxonomyEdit { Name = _newName.Trim() }, ct); }
            catch (CmsException ex) when (ex.Message == "網址代稱已存在，請使用其他代稱。")
            {
                throw new CmsException($"相同名稱或網址代稱的{Label}已存在。請刷新選項後選取既有項目，或改用其他名稱。");
            }
            _created = new(saved.Id!.Value, saved.Name, saved.Slug, saved.Version);
            Selected.Add(_created.Id);
            _newName = "";
            // 即使之後刷新列表失敗，仍保留成功的選取結果。
            await Changed.InvokeAsync();
            await LoadOptions(ct);
        }, $"已建立並選取{Label}；本文尚未儲存。");
    }
    private async Task Move(int delta)
    {
        if (Disabled || Blocked) return;
        var previousPage = _page;
        _page += delta;
        if (!await Load()) _page = previousPage;
    }
    private async Task Toggle(Guid id, bool selected)
    {
        if (Disabled || Blocked) return;
        if (selected && !Selected.Contains(id))
        {
            if (AtLimit) { Error = $"每篇文章最多 {Limits.MaxTaxonomiesPerKind} 個{Label}，請先取消選取。"; return; }
            Selected.Add(id);
        }
        if (!selected) Selected.Remove(id);
        await Changed.InvokeAsync();
    }
    private async Task Clear()
    {
        if (Disabled || Blocked) return;
        Selected.Clear();
        await Changed.InvokeAsync();
    }
}
