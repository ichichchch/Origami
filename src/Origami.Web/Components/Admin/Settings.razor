@page "/admin/settings"
@rendermode InteractiveServer
@attribute [Authorize]
@layout AdminLayout
@inherits AdminComponentBase
@inject SettingsService SettingsService
@inject ContentService Content
@inject MediaService Media
@inject ImportService Importer

<PageTitle>網站設定 · 內容管理</PageTitle>
<UnsavedGuard Dirty="Dirty" Busy="Busy" />
<div class="page-heading"><div><p class="eyebrow">讓網站成為你的樣子</p><h1>網站設定</h1><p>簡單的介紹，是讀者認識你的第一步。</p></div></div>
<AdminFeedback Busy="Busy" Error="@Error" Notice="@Notice" LoginRequired="LoginRequired" />
@if (_confirmReload)
{
    <section class="notice notice-danger" role="alertdialog" aria-labelledby="settings-reload-title"><h2 id="settings-reload-title">捨棄輸入並重新載入？</h2><p>請先複製要保留的文字。重新載入會取代目前未儲存的輸入。</p><div class="button-row"><button class="button button-danger" disabled="@Blocked" @onclick="Reload">確認重新載入</button><button class="button button-secondary" disabled="@Blocked" @onclick="() => _confirmReload = false">繼續編輯</button></div></section>
}
@if (_model is not null)
{
    <section class="panel settings-panel settings-width">
        <div class="panel-intro"><h2>基本資訊</h2><p>儲存後會立即用於公開網站的名稱與說明。</p></div>
        <EditForm Model="_model" OnSubmit="Save" FormName="site-settings">
            <fieldset disabled="@Blocked">
                <div class="field"><label for="site-name">網站名稱 <span class="required">必填</span></label><input id="site-name" @bind="_model.Name" @bind:event="oninput" maxlength="@Limits.SiteName" required aria-describedby="site-name-help" /><span id="site-name-help" class="field-help">最多 @Limits.SiteName 字，顯示於網站頁首。</span></div>
                <div class="field"><label for="site-description">網站說明</label><textarea id="site-description" @bind="_model.Description" @bind:event="oninput" maxlength="@Limits.Description" rows="4" aria-describedby="site-description-help"></textarea><span id="site-description-help" class="field-help">用一小段文字介紹網站，最多 @Limits.Description 字。不支援 HTML。</span></div>
                <div class="panel-intro reading-intro"><h2>閱讀設定</h2><p>控制首頁與文章列表的呈現方式。</p></div>
                <div class="field">
                    <label for="home-page">首頁顯示</label>
                    <select id="home-page" disabled="@Blocked" value="@(_model.HomePageContentId?.ToString() ?? "")" @onchange="HomeChanged">
                        <option value="">最新文章列表</option>
                        @foreach (var option in _homeOptions)
                        {
                            <option value="@option.Id">@option.Title</option>
                        }
                    </select>
                    <span class="field-help">選擇已發布頁面作為首頁時，文章列表會改到 /posts；頁面撤回或轉為私密時自動退回文章列表。</span>
                </div>
                <div class="field"><label for="posts-per-page">每頁文章數</label><input id="posts-per-page" type="number" min="1" max="@Limits.MaxPageSize" @bind="_model.PostsPerPage" disabled="@Blocked" aria-describedby="posts-per-page-help" /><span id="posts-per-page-help" class="field-help">1–@Limits.MaxPageSize；留空使用預設 @Limits.PageSize 篇。</span></div>
                <div class="field"><label for="feed-items">RSS Feed 條數</label><input id="feed-items" type="number" min="1" max="@Limits.MaxFeedItems" @bind="_model.FeedItems" disabled="@Blocked" aria-describedby="feed-items-help" /><span id="feed-items-help" class="field-help">1–@Limits.MaxFeedItems；留空使用預設 @Limits.FeedItems 篇。</span></div>
                <div class="field">
                    <label for="site-icon">網站圖示（favicon）</label>
                    <select id="site-icon" disabled="@Blocked" value="@(_model.SiteIconMediaId?.ToString() ?? "")" @onchange="IconChanged">
                        <option value="">無（瀏覽器顯示預設圖示）</option>
                        @foreach (var option in _iconOptions)
                        {
                            <option value="@option.Id">@option.Label</option>
                        }
                    </select>
                    <span class="field-help">從媒體庫選擇圖片作為瀏覽器分頁與書籤的圖示；正方形圖片效果最好。</span>
                </div>
                <div class="form-footer"><button type="submit" class="button">@(Busy ? "儲存中…" : "儲存設定")</button><span class="save-indicator" role="status">@(Dirty ? "有未儲存的變更" : "目前為儲存版本")</span></div>
            </fieldset>
        </EditForm>
    </section>
}
@if (_model is not null)
{
    <section class="panel settings-panel settings-width">
        <div class="panel-intro"><h2>資料匯出</h2><p>將站點設定、分類標籤、內容全文（含草稿）與媒體中繼資料匯出為 JSON 檔。圖片檔案與帳號資料不包含在內。</p><p class="field-help">匯出檔包含受密碼保護內容的密碼雜湊，可離線破解，請視為機密檔案並妥善保管。</p></div>
        <a class="button button-secondary" href="/admin/export" download data-enhance-nav="false">下載資料匯出（JSON）</a>
    </section>
    <section class="panel settings-panel settings-width">
        <div class="panel-intro"><h2>資料匯入</h2><p>以匯出檔<strong>取代</strong>站內全部文字資料（設定、分類標籤、內容、媒體中繼資料）。圖片檔案不會隨匯入變動，搬遷網站時請同時還原儲存目錄。</p></div>
        @if (_importPreview is not null)
        {
            <div class="notice" role="status">
                <p>已讀取匯出檔：<strong>@_importPreview.SiteName</strong>，將匯入 @_importPreview.Categories 個分類、@_importPreview.Tags 個標籤、@_importPreview.Posts 篇文章、@_importPreview.Pages 個頁面、@_importPreview.Media 筆媒體中繼資料。</p>
            </div>
        }
        @if (_importPreview is not null)
        {
            <section class="notice notice-danger" role="alertdialog" aria-labelledby="import-confirm-title">
                <h2 id="import-confirm-title">確認匯入並取代現有資料？</h2>
                <p>現有設定、分類標籤、內容與媒體中繼資料會被<strong>永久取代</strong>；已發表的公開文章會重新排入 AI 索引。此動作無法復原，建議先下載最新的資料匯出。</p>
                <div class="button-row">
                    <button type="button" class="button button-danger" disabled="@Blocked" @onclick="ApplyImport">確認匯入</button>
                    <button type="button" class="button button-secondary" disabled="@Blocked" @onclick="CancelImport">取消</button>
                </div>
            </section>
        }
        else
        {
            <label class="button button-secondary" for="import-file">選擇匯出檔（JSON）</label>
            <InputFile id="import-file" OnChange="ChooseImport" accept=".json,application/json" class="import-file-input" />
            @if (_importError is not null)
            {
                <p class="notice notice-error" role="alert">@_importError</p>
            }
        }
    </section>
}
@if (!LoginRequired)
{
    <button class="text-button reload-settings" disabled="@Blocked" @onclick="RequestReload">重新載入儲存版本</button>
}

@code {
    private SiteSettings? _model;
    private string _baseline = "";
    private bool _confirmReload;
    private List<PageOption> _homeOptions = [];
    private List<(Guid Id, string Label)> _iconOptions = [];
    private bool Dirty => _model is not null && Snapshot(_model) != _baseline;
    private static string Snapshot(SiteSettings model) => System.Text.Json.JsonSerializer.Serialize(model);
    protected override Task OnInitializedAsync() => Load();
    private Task Load() => RunAsync(async ct =>
    {
        _model = await SettingsService.GetAsync(ct);
        _homeOptions = (await Content.PageOptionsAsync(ct))
            .Where(x => x.Status == ContentStatus.Published && !x.IsPrivate && !x.IsProtected).ToList();
        var media = await Media.ListAsync(1, Limits.MaxPageSize, ct);
        _iconOptions = [.. media.Items.Select(x => (x.Id, $"{x.OriginalName}（{x.Width}×{x.Height}）"))];
        _baseline = Snapshot(_model);
    });
    private void HomeChanged(ChangeEventArgs args)
    {
        if (_model is null) return;
        _model.HomePageContentId = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : null;
    }
    private void IconChanged(ChangeEventArgs args)
    {
        if (_model is null) return;
        _model.SiteIconMediaId = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : null;
    }
    private ImportService.ImportPreview? _importPreview;
    private byte[]? _importFile;
    private string? _importError;

    private async Task ChooseImport(InputFileChangeEventArgs args)
    {
        _importError = null;
        _importPreview = null;
        _importFile = null;
        if (Blocked) return;
        try
        {
            await using (var stream = args.File.OpenReadStream(Limits.ImportMaxBytes))
            using (var buffer = new MemoryStream())
            {
                await stream.CopyToAsync(buffer);
                _importFile = buffer.ToArray();
            }
            using var input = new MemoryStream(_importFile);
            _importPreview = await Importer.AnalyzeAsync(input);
        }
        catch (CmsException error) { _importError = error.Message; }
        catch (IOException) { _importError = "匯入檔超過大小上限。"; }
    }

    private Task ApplyImport() => RunAsync(async ct =>
    {
        if (_importFile is null) return;
        using var input = new MemoryStream(_importFile);
        await Importer.ApplyAsync(input, confirmed: true, ct);
        _importFile = null;
        _importPreview = null;
        await Load();
    }, "資料已匯入，網站內容已取代為匯出檔版本。");

    private void CancelImport()
    {
        _importFile = null;
        _importPreview = null;
        _importError = null;
    }
    private async Task RequestReload()
    {
        if (Blocked) return;
        if (Dirty) _confirmReload = true; else await Load();
    }
    private async Task Reload() { _confirmReload = false; await Load(); }
    private Task Save() => RunAsync(async ct =>
    {
        if (_model is null) return;
        ContentRules.Validate(_model);
        var input = new SiteSettings
        {
            Id = _model.Id, Name = _model.Name, Description = _model.Description, Version = _model.Version,
            PostsPerPage = _model.PostsPerPage, FeedItems = _model.FeedItems,
            HomePageContentId = _model.HomePageContentId, SiteIconMediaId = _model.SiteIconMediaId,
        };
        _model = await SettingsService.SaveAsync(input, ct);
        _baseline = Snapshot(_model);
    }, "網站設定已儲存，公開網站已更新。");
}
