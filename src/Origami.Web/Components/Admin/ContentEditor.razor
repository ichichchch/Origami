    private async Task RunEditingHeartbeatAsync(Guid contentId, CancellationToken cancellation)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Limits.EditingHeartbeatSeconds));
        try
        {
            await InvokeAsync(() => TouchEditingAsync(contentId, cancellation));
            while (!cancellation.IsCancellationRequested && await timer.WaitForNextTickAsync(cancellation))
                await InvokeAsync(() => TouchEditingAsync(contentId, cancellation));
        }
        catch (OperationCanceledException) { /* circuit 已關閉；占用由釋放或逾期收尾。 */ }
        catch (ObjectDisposedException) { /* 等待計時器期間元件已被處置。 */ }
    }

    private async Task TouchEditingAsync(Guid contentId, CancellationToken cancellation)
    {
        if (cancellation.IsCancellationRequested || _model?.Id != contentId || !EditAllowed || Blocked) return;
        try
        {
            var state = await Api.TouchEditingAsync(contentId, ct: cancellation);
            _editingHeldByOther = state?.HeldByOther ?? false;
            _editingHolderName = state?.DisplayName ?? "";
        }
        catch (CmsException error) { Error = error.Message; }
        catch (UnauthorizedAccessException) { RequireLogin(); }
        catch (AccessDeniedException error) { _canEditThis = false; Error = error.Message; }
        catch (HttpRequestException)
        {
            Error = UiText.T("Admin.ContentEditor.EditingStatusUnavailable", "暫時無法確認編輯占用狀態，請保留輸入並檢查連線。");
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (!cancellation.IsCancellationRequested) StateHasChanged();
        }
    }

    private Task TakeOverEditingAsync() => RunSaveAsync(async ct =>
    {
