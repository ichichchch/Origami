    private void RestoreRevision(RevisionDetail revision)
    {
        // 還原把完整快照載入編輯器（含標題、代稱、本文、摘要、SEO、封面、作者、分類標籤、自訂詞彙與自訂欄位）；管理員儲存前不會寫入任何資料。
        _model!.Title = revision.Title;
        if (!string.IsNullOrWhiteSpace(revision.Slug)) _model.Slug = revision.Slug;
        _model.Markdown = revision.Markdown;
        _model.Excerpt = revision.Excerpt;
        _model.MetaDescription = revision.MetaDescription;
        _model.NoIndex = revision.NoIndex;
        _model.IsSticky = revision.IsSticky;
        _model.AllowComments = revision.AllowComments;
        _model.MenuOrder = revision.MenuOrder;
        _model.ParentId = revision.ParentId;
        _model.CoverMediaId = revision.CoverMediaId;
        _model.CoverFileName = revision.CoverFileName;
        _model.CoverAltText = revision.CoverAltText;
        _model.CoverCaption = revision.CoverCaption;
        if (!string.IsNullOrWhiteSpace(revision.AuthorId)) _model.AuthorId = revision.AuthorId;
        if (!string.IsNullOrWhiteSpace(revision.AuthorName)) _model.AuthorName = revision.AuthorName;
        if (revision.CategoryIds.Count > 0 || _model.Kind == ContentKind.Post) _model.CategoryIds = [.. revision.CategoryIds];
        if (revision.TagIds.Count > 0 || _model.Kind == ContentKind.Post) _model.TagIds = [.. revision.TagIds];
        _selectedTermIds = [.. revision.CustomTermIds];
        _model.CustomTermIds = [.. revision.CustomTermIds];
        _fieldValues = revision.FieldValues.ToDictionary(x => x.FieldId, x => x.Value);
        _model.FieldValues = [.. revision.FieldValues];
        _revisionView = null;
        _revisionDiff = null;
        _diffTooLarge = false;
        _preview = false;
