            : new ContentEdit { Kind = InferNewKind() };
        // 既有內容：作者僅能編輯自己建立的內容。
        _canEditThis = loaded.Id is null
            ? _canEditThis
            : CanEdit || (Access?.Role == SiteRole.Author && loaded.AuthorId is not null && loaded.AuthorId == Access.UserId);
        _model = loaded;
        _types = await Api.ListContentTypesAsync(ct);
        _selectedTermIds = loaded.CustomTermIds.ToList();
        _termGroups = loaded.ContentTypeId is { } loadedTypeId
            ? await Api.TermsForContentTypeAsync(loadedTypeId, ct)
            : [];
        _fields = loaded.ContentTypeId is { } loadedFieldTypeId
            ? await Api.ListCustomFieldsAsync(loadedFieldTypeId, ct)
            : [];
        _fieldValues = loaded.FieldValues.ToDictionary(x => x.FieldId, x => x.Value);
        _editingHeldByOther = loaded.EditingByOther;
        _editingHolderName = loaded.EditingByName;
        if (CanEdit) _authors = await Api.AuthorOptionsAsync(ct) ?? [];
        if (loaded.Kind == ContentKind.Page) _pageOptions = await Api.PageOptionsAsync(ct) ?? [];
        _baseline = Snapshot(loaded);
        // 已儲存的排程應填入選擇器；此時時區可能還無法得知，
        // 等瀏覽器回報後會再次套用。
        _scheduleTouched = false;
        _scheduleLocal = ToLocalOffset(loaded.PublishAt);
        _preview = false;
