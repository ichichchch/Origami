    /// <summary>上層候選頁面（標籤含祖先路徑）；已排除頁面本身與其子樹。</summary>
    private List<(Guid Id, string Label)> ParentChoices()
    {
        if (_model is null) return [];
        var byId = _pageOptions.ToDictionary(x => x.Id);
        var children = _pageOptions.Where(x => x.ParentId is not null && byId.ContainsKey(x.ParentId.Value))
            .ToLookup(x => x.ParentId!.Value);
        HashSet<Guid> excluded = [];
        if (_model.Id is { } self)
        {
            var stack = new Stack<Guid>();
            stack.Push(self);
            while (stack.Count > 0)
                foreach (var child in children[stack.Pop()])
                    if (excluded.Add(child.Id)) stack.Push(child.Id);
        }
        string Label(PageOption page)
        {
            var parts = new List<string> { page.Title };
            var guard = 0;
            for (Guid? cursor = page.ParentId; cursor is { } current && byId.TryGetValue(current, out var node) && ++guard <= 10; cursor = node.ParentId)
                parts.Insert(0, node.Title);
            return string.Join(" › ", parts);
        }
        return [.. _pageOptions.Where(x => !excluded.Contains(x.Id)).Select(x => (x.Id, Label(x)))];
    }
