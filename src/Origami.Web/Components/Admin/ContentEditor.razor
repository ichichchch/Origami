        var copy = await Api.DuplicateContentAsync(id, ct)
            ?? throw new CmsException(UiText.T("Admin.ContentEditor.DuplicateFailed", "無法複製內容，請重試。"));
        Navigation.NavigateTo("/admin/content/" + copy.Id + "?saved=draft", forceLoad: true);
    });

    private async Task ToggleInternalLinks()
    {
        _linkPickerOpen = !_linkPickerOpen;
        if (_linkPickerOpen && _linkResults.Count == 0)
            await SearchInternalLinksAsync();
    }

    private Task SearchInternalLinksAsync() => RunAsync(async ct =>
    {
        var q = string.IsNullOrWhiteSpace(_linkQuery) ? null : _linkQuery.Trim();
        var posts = await Api.ListAdminAsync(ContentKind.Post, 1, 10, ContentStatus.Published, q, ct);
        var pages = await Api.ListAdminAsync(ContentKind.Page, 1, 10, ContentStatus.Published, q, ct);
        _linkResults = [.. (posts?.Items ?? []), .. (pages?.Items ?? [])];
    });

    private void InsertInternalLink(ContentSummary target)
    {
        if (_model is null || Blocked) return;
        var prefix = target.Kind == ContentKind.Page ? "/pages/" : "/posts/";
        var md = $"[{target.Title}]({prefix}{target.Slug})";
        if ((_model.Markdown?.Length ?? 0) + md.Length + 2 > Limits.Body) return;
        _model.Markdown = (_model.Markdown ?? "").TrimEnd() + " " + md;
        _linkPickerOpen = false;
        _preview = false;
    }

    private async Task UploadInlineFilesAsync(InputFileChangeEventArgs args)
    {
        if (_model is null || SaveBlocked) return;
        var files = args.GetMultipleFiles(Limits.MediaBatchMax);
        if (files.Count == 0) return;
        await RunSaveAsync(async ct =>
        {
            var results = await Api.UploadMediaBatchAsync(files, ct)
                ?? throw new CmsException(UiText.T("Admin.Media.BatchUploadFailed", "批次上傳失敗，請重新嘗試。"));
            var uploaded = results.Where(x => x.Succeeded && x.Item is not null).Select(x => x.Item!).ToList();
            if (uploaded.Count == 0)
                throw new CmsException(results.FirstOrDefault()?.Message ?? "檔案上傳失敗。");
            foreach (var item in uploaded)
                InsertMedia(item);
        }, UiText.T("Admin.ContentEditor.InlineUploadSuccess", "已上傳並插入媒體語法。"));
    }
    /// <summary>
    /// 以本文目前的選取範圍作為手寫摘要（WP「more 切點」的在地化形式）：
    /// 選取文字先轉為純文字，超過上限時截斷。沒有選取時提示而非猜測。
    /// </summary>
    private async Task ExcerptFromSelection()
    {
        if (_model is null || Blocked) return;
        string? selected;
        try
        {
            selected = await JavaScript.InvokeAsync<string?>("eval",
                "(()=>{const el=document.getElementById('content-markdown');return el?el.value.slice(el.selectionStart,el.selectionEnd):'';})()");
        }
        catch (JSException)
        {
            Error = UiText.T("Admin.ContentEditor.SelectionReadFailed", "無法讀取本文選取範圍，請手動把摘要複製到欄位中。");
            return;
        }
        if (string.IsNullOrWhiteSpace(selected))
        {
            Notice = null;
            Error = UiText.T("Admin.ContentEditor.SelectionRequired", "請先在本文中選取要作為摘要的文字，再按「以本文選取文字填入」。");
            return;
        }
        var text = MarkdownRenderer.PlainText(selected);
        if (text.Length > Limits.Excerpt)
        {
            // 代理配對邊界向內退一字，避免切出無效的字元。
            var cut = char.IsHighSurrogate(text[Limits.Excerpt - 1]) ? Limits.Excerpt - 1 : Limits.Excerpt;
            text = text[..cut].TrimEnd();
            Notice = string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.ContentEditor.SelectionTruncated", "選取文字已轉為純文字並截斷為 {0} 字。"), text.Length);
        }
        else Notice = null;
        _model.Excerpt = text;
        Error = null;
    }
    private void SelectionChanged() => StateHasChanged();
}
