@page "/admin/posts/new"
@page "/admin/pages/new"
@page "/admin/content/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@layout AdminLayout
@inherits AdminComponentBase
@inject ContentService Content
@inject MarkdownService MarkdownRenderer
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>@(_model?.Id is null ? "新增內容" : "編輯內容") · 內容管理</PageTitle>
<UnsavedGuard Dirty="Dirty" Busy="@(Busy || ChildBusy)" />
<div class="page-heading">
    <div><a class="back-link" href="@ListPath">← 返回@(KindLabel)列表</a><h1>@(_model?.Id is null ? "新增" : "編輯")@(KindLabel)</h1><p>專注寫作，準備好再與世界分享。</p></div>
    <span class="save-indicator @(Dirty ? "unsaved" : "")" role="status">@SaveStatusText</span>
    @if (_autosaveAt is { } at)
    {
        <span class="save-indicator autosaved" role="status">已自動儲存 @at.ToString("HH:mm")</span>
    }
</div>
<AdminFeedback Busy="Busy" Error="@Error" Notice="@Notice" LoginRequired="LoginRequired" />@if (Error is not null && !LoginRequired)
{
    <p class="field-help">輸入仍保留。若資料衝突，請先複製需要的內容，再重新載入最新版本。</p>
    <button class="button button-secondary" disabled="@SaveBlocked" @onclick="RequestReload">重新載入最新版本</button>
}
@if (_reloadRequested)
{
    <section class="notice notice-danger" role="alertdialog" aria-labelledby="reload-title">
        <h2 id="reload-title">捨棄輸入並重新載入？</h2><p>目前未儲存的輸入將被取代。請先複製要保留的內容。</p>
        <div class="button-row"><button class="button button-danger" disabled="@SaveBlocked" @onclick="Reload">確認重新載入</button><button class="button button-secondary" disabled="@Blocked" @onclick="() => _reloadRequested = false">繼續編輯</button></div>
    </section>
}
@if (_model is not null)
{
    <EditForm Model="_model" OnSubmit="SaveCurrent" FormName="content-editor">
        <fieldset disabled="@Blocked" class="editor-grid">
            <div class="editor-main">
                <section class="panel editor-fields">
                    <div class="field"><label for="content-title">標題 <span class="required">必填</span></label><input id="content-title" class="title-input" @bind="_model.Title" @bind:event="oninput" maxlength="@Limits.Title" required placeholder="給這個想法一個標題" /><span class="field-help">最多 @Limits.Title 字。</span></div>
                    <div class="field"><label for="content-slug">網址代稱</label><div class="input-prefix"><span>/@(_model.Kind == ContentKind.Post ? "posts" : "pages")/</span><input id="content-slug" @bind="_model.Slug" @bind:event="oninput" maxlength="@Limits.Slug" required="@(_model.Id is not null)" aria-describedby="slug-help" placeholder="首次儲存可留空，自標題產生" /></div><span id="slug-help" class="field-help">代稱須全站唯一；修改後舊網址不會自動轉址。</span></div>
                    <div class="field"><label for="content-excerpt">摘要</label><textarea id="content-excerpt" @bind="_model.Excerpt" @bind:event="oninput" maxlength="@Limits.Excerpt" rows="3" aria-describedby="excerpt-help" placeholder="用一兩句話介紹這篇內容；留空則自動使用開頭文字"></textarea><span id="excerpt-help" class="field-help">純文字，最多 @Limits.Excerpt 字；顯示於文章列表、搜尋結果與社群分享描述。</span></div>
                    @if (_model.Kind == ContentKind.Page)
                    {
                        <div class="field">
                            <label for="content-parent">上層頁面（選填）</label>
                            <select id="content-parent" disabled="@Blocked" value="@(_model.ParentId?.ToString() ?? "")" @onchange="ParentChanged">
                                <option value="">無（最上層）</option>
                                @foreach (var choice in ParentChoices())
                                {
                                    <option value="@choice.Id">@choice.Label</option>
                                }
                            </select>
                            <span class="field-help">設定後此頁面會排列於該頁面之下（導覽與列表）；網址仍是獨立的 /pages/代稱，不會改變。</span>
                        </div>
                    }
                </section>
                <section class="panel markdown-panel">
                    <div class="panel-toolbar"><div class="button-row"><button type="button" class="tab-button @(!_preview ? "active" : "")" aria-pressed="@(!_preview)" @onclick="() => _preview = false">Markdown</button><button type="button" class="tab-button @(_preview ? "active" : "")" aria-pressed="@_preview" disabled="@ChildBusy" @onclick="Preview">預覽</button></div><button type="button" class="button button-secondary button-small" disabled="@_mediaBusy" @onclick="ToggleMedia">插入圖片</button></div>
                    @if (_preview)
                    {
                        <div class="prose editor-preview" aria-label="尚未儲存的內容預覽">@((MarkupString)_previewHtml)</div>
                        <p class="editor-footnote">這是目前輸入的預覽，不代表已儲存或已發布。</p>
                    }
                    else
                    {
                        <label class="sr-only" for="content-markdown">Markdown 本文</label><textarea id="content-markdown" class="markdown-input" @bind="_model.Markdown" @bind:event="oninput" maxlength="@Limits.Body" rows="22" placeholder="從這裡開始寫作…" aria-describedby="markdown-help"></textarea>
                        <div class="editor-footnote"><span id="markdown-help">支援 Markdown；不執行原始 HTML。</span><span>@((_model.Markdown?.Length ?? 0).ToString("N0")) / @Limits.Body.ToString("N0") 字</span></div>
                    }
                </section>
                @if (_mediaOpen)
                {
                    <MediaPicker Disabled="Blocked" Select="InsertMedia" Close="ToggleMedia" BusyChanged="value => _mediaBusy = value" OnUnauthorized="RequireLogin" />
                }
            </div>
            <aside class="editor-aside">
                <section class="panel publish-panel">
                    <h2>發布設定</h2><div class="status-line"><span>目前狀態</span><span class="status-badge @(_model.Status == ContentStatus.Published ? "published" : "draft")">@(_model.Status == ContentStatus.Published ? "已發布" : "草稿")</span></div>
                    @if (_model.Kind == ContentKind.Post)
                    {
                        <div class="field checkbox-field">
                            <label for="content-sticky"><input id="content-sticky" type="checkbox" @bind="_model.IsSticky" disabled="@Blocked" /> 置頂文章</label>
                            <p class="field-help">置頂文章固定排在文章列表最前面。</p>
                        </div>
                    }
                    @if (_model.Id is not null)
                    {
                        <p class="field-help">累積瀏覽 @_model.Views 次。</p>
                    }
                    <div class="field checkbox-field">
                        <label for="content-protect"><input id="content-protect" type="checkbox" @bind="_model.IsProtected" disabled="@(Blocked || _model.IsPrivate)" /> 密碼保護</label>
                        <p class="field-help">公開網址需輸入密碼才能閱讀內文；受保護內容不進入搜尋與 AI 檢索。</p>
                    </div>
                    <div class="field checkbox-field">
                        <label for="content-private"><input id="content-private" type="checkbox" @bind="_model.IsPrivate" disabled="@(Blocked || _model.IsProtected)" /> 私密</label>
                        <p class="field-help">公開網址僅管理員登入後可讀，訪客與搜尋引擎一律 404；私密內容不進入搜尋與 AI 檢索。</p>
                    </div>
                    @if (_model.IsProtected)
                    {
                        <div class="field">
                            <label for="protect-password">@(_model.HasProtectPassword ? "更換保護密碼（選填）" : "設定保護密碼")</label>
                            <input id="protect-password" type="password" maxlength="1024" @bind="_protectPassword" disabled="@Blocked" autocomplete="new-password" aria-describedby="protect-help" />
                            <span id="protect-help" class="field-help">@(_model.HasProtectPassword ? "留空表示沿用目前的保護密碼。" : "首次啟用需設定密碼，至少 8 個字元。")</span>
                        </div>
                    }
                    @if (_model.Status == ContentStatus.Draft)
                    {
                        <div class="field">
                            <label for="content-schedule">排程發布時間（選填）</label>
                            <input id="content-schedule" type="datetime-local" @bind="_scheduleLocal" @bind:after="() => _scheduleTouched = true" disabled="@Blocked" aria-describedby="schedule-help" />
                            <span id="schedule-help" class="field-help">以你瀏覽器的時區為準，至少 @Limits.ScheduleLeadMinutes 分鐘後；時間到系統自動發布。留空表示不排程。</span>
                        </div>
                        @if (_model.Id is not null)
                        {
                            <div class="field">
                                <label id="preview-link-label">草稿預覽連結</label>
                                @if (_model.PreviewToken is { } token)
                                {
                                    <input class="code-input" value="@PreviewUrl(token)" readonly aria-labelledby="preview-link-label" />
                                    <div class="button-row">
                                        <button type="button" class="button button-secondary button-small" disabled="@SaveBlocked" @onclick="CyclePreview">重新產生連結</button>
                                        <button type="button" class="text-button" disabled="@SaveBlocked" @onclick="RevokePreview">撤銷</button>
                                    </div>
                                    <span class="field-help">持有連結的人都能閱讀這份草稿（不會進入搜尋）；重新產生或撤銷後，舊連結立即失效。</span>
                                }
                                else
                                {
                                    <button type="button" class="button button-secondary button-small" disabled="@SaveBlocked" @onclick="CyclePreview">產生預覽連結</button>
                                    <span class="field-help">產生臨時連結，在發布前分享草稿給其他人看。</span>
                                }
                            </div>
                        }
                    }
                    <p class="field-help">@(_model.Status == ContentStatus.Published ? "儲存會立即更新公開網站。撤回後，文字內容將不再公開。" : "草稿僅供管理員編輯，發布後訪客才能閱讀。")</p>
                    <button type="submit" class="button full-width" disabled="@SaveBlocked">@(SubmitText)</button>
                    @if (_model.Status == ContentStatus.Draft)
                    {
                        <button type="button" class="button button-secondary full-width" disabled="@SaveBlocked" @onclick="() => Save(ContentStatus.Published)">儲存並發布</button>
                    }
                    else
                    {
                        <button type="button" class="button button-secondary full-width" disabled="@SaveBlocked" @onclick="() => Save(ContentStatus.Draft)">儲存並撤回為草稿</button>
                        <a class="public-preview-link" href="@PublicPath" target="_blank" rel="noopener" data-enhance-nav="false">檢視公開版本 ↗</a>
                    }
                    @if (ChildBusy) { <p class="field-help" role="status">分類、標籤或圖片操作尚未完成，請稍候再儲存；可繼續編輯本文。</p> }
                    <p class="field-help">既有草稿每 @Limits.AutosaveSeconds 秒自動儲存一次（僅草稿）。首次發布日期由系統保留，重新發布不會重設。</p>
                </section>
                @if (_model.Kind == ContentKind.Post)
                {
                    <section class="panel taxonomy-panel">
                        <TaxonomySelector Kind="TaxonomyKind.Category" Selected="_model.CategoryIds" Disabled="Blocked" Changed="SelectionChanged" BusyChanged="value => _categoryBusy = value" OnUnauthorized="RequireLogin" />
                        <TaxonomySelector Kind="TaxonomyKind.Tag" Selected="_model.TagIds" Disabled="Blocked" Changed="SelectionChanged" BusyChanged="value => _tagBusy = value" OnUnauthorized="RequireLogin" />
                    </section>
                }
                @if (_model.Id is not null)
                {
                    <section class="panel revisions-panel">
                        <div class="panel-toolbar"><h2>修訂版本</h2><button type="button" class="text-button" disabled="@Blocked" @onclick="ToggleRevisions">@(_revisionsOpen ? "收起" : "查看")</button></div>
                        @if (_revisionsOpen)
                        {
                            @if (_revisionView is not null)
                            {
                                <div class="revision-view">
                                    <p><strong>@_revisionView.Title</strong> · @_revisionView.CreatedAt.ToString("yyyy.MM.dd HH:mm") UTC</p>
                                    <label class="sr-only" for="@("revision-body-" + _revisionView.Id)">修訂內容（Markdown）</label>
                                    <pre id="@("revision-body-" + _revisionView.Id)" class="revision-body">@_revisionView.Markdown</pre>
                                    @if (_revisionView.Excerpt != "") { <p class="field-help">摘要：@_revisionView.Excerpt</p> }
                                    <div class="button-row">
                                        <button type="button" class="button button-secondary button-small" disabled="@Blocked" @onclick="() => RestoreRevision(_revisionView)">載入至編輯器</button>
                                        <button type="button" class="text-button" disabled="@Blocked" @onclick="() => _revisionView = null">關閉</button>
                                    </div>
                                    <p class="field-help">載入會覆蓋編輯器目前內容（未儲存前可再次還原），確認後仍需手動儲存。</p>
                                </div>
                            }
                            @if (_revisions.Count == 0)
                            {
                                <p class="field-help">還沒有修訂記錄；每次儲存都會保留前一版，最多 @Limits.RevisionKeep 筆。</p>
                            }
                            else
                            {
                                <ul class="revision-list">
                                    @foreach (var revision in _revisions)
                                    {
                                        <li><span>@revision.CreatedAt.ToString("MM.dd HH:mm") @revision.Title</span><span class="button-row"><button type="button" class="text-button" disabled="@Blocked" @onclick="() => ViewRevision(revision.Id)">查看</button><button type="button" class="text-button" disabled="@Blocked" @onclick="() => RestoreRevisionById(revision.Id)">還原</button></span></li>
                                    }
                                </ul>
                            }
                        }
                    </section>
                }
                <p class="privacy-note">所有上傳圖片均為公開資源，草稿中的圖片也不例外。撤回文章不會隱藏圖片網址。</p>
                @if (_model.Id is not null) { <button type="button" class="text-button" disabled="@SaveBlocked" @onclick="RequestReload">重新載入儲存版本</button> }
            </aside>
        </fieldset>
    </EditForm>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    // The save result travels in the URL, so only the tab that performed the save sees it.
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }
    private ContentEdit? _model;
    private string _baseline = "";
    private Guid? _loadedId;
    private bool _loaded;
    private bool _preview;
    private string _previewHtml = "";
    private bool _mediaOpen;
    private bool _reloadRequested;
    private bool _mediaBusy;
    private bool _categoryBusy;
    private bool _tagBusy;
    private bool _revisionsOpen;
    private List<RevisionItem> _revisions = [];
    private RevisionDetail? _revisionView;
    private DateTimeOffset? _autosaveAt;
    private bool _autosaveStopped;
    private int _tzOffsetMinutes;
    private string _timeZoneId = "";
    private TimeZoneInfo? _timeZone;
    private DateTimeOffset? _scheduleLocal;
    private bool _scheduleTouched;
    private string _protectPassword = "";
    private List<PageOption> _pageOptions = [];
    private CancellationTokenSource? _autosaveCts;
    private bool ChildBusy => _mediaBusy || _categoryBusy || _tagBusy;
    // Do not feed ChildBusy into the outer fieldset or child Disabled parameters:
    // each child must finish its operation and callbacks without disabling itself through the parent.
    private bool SaveBlocked => Blocked || ChildBusy;
    private string KindLabel => _model?.Kind == ContentKind.Page ? "頁面" : "文章";
    private string ListPath => _model?.Kind == ContentKind.Page ? "/admin/pages" : "/admin/posts";
    private string PublicPath => (_model?.Kind == ContentKind.Page ? "/pages/" : "/posts/") + Uri.EscapeDataString(_model?.Slug ?? "");
    private bool Dirty => _model is not null && (Snapshot(_model) != _baseline || ScheduleChanged);
    // The schedule lives beside the model, so a changed publish time is an unsaved change too.
    private bool ScheduleChanged => _model is not null && EffectiveSchedule() != _model.PublishAt;
    /// <summary>The picked time in UTC; a wall-clock time that does not exist never matches a stored one.</summary>
    private DateTimeOffset? EffectiveSchedule()
    {
        if (_scheduleLocal is null) return null;
        try { return FromLocalPick(_scheduleLocal); }
        catch (CmsException) { return DateTimeOffset.MinValue; }
    }
    private string SaveStatusText
    {
        get
        {
            if (Dirty) return "有未儲存的變更";
            if (_model?.Id is not null) return "已載入儲存版本";
            return "尚未儲存";
        }
    }
    private string SubmitText
    {
        get
        {
            if (Busy) return "處理中…";
            return _model!.Status == ContentStatus.Published ? "儲存變更" : "儲存草稿";
        }
    }
    private ContentKind InferNewKind() => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin/pages/", StringComparison.OrdinalIgnoreCase)
        ? ContentKind.Page : ContentKind.Post;
    private static string SaveNotice(ContentStatus status, bool wasPublished)
    {
        if (status == ContentStatus.Published) return "已儲存並公開。";
        if (wasPublished) return "已撤回為草稿，文字內容不再公開。";
        return "已儲存為草稿，文字內容不對外公開。";
    }
    // The snapshot covers the editable fields only: server-owned values and the share token
    // never make the editor look dirty.
    private static string Snapshot(ContentEdit model) => System.Text.Json.JsonSerializer.Serialize(new
    {
        model.Id, model.Kind, model.Title, model.Slug, model.Markdown, model.Excerpt, model.IsSticky,
        model.IsProtected, model.IsPrivate, model.ParentId, model.PublishAt, model.Status, model.Version,
        model.CategoryIds, model.TagIds
    });

    protected override async Task OnParametersSetAsync()
    {
        // A full document load creates a new component instance, so the identifier is
        // the only state that decides whether the stored version must be reloaded.
        if (_loaded && _loadedId == Id) return;
        _loaded = true;
        _loadedId = Id;
        _model = null;
        _mediaOpen = false;
        _preview = false;
        _reloadRequested = false;
        _revisionsOpen = false;
        _revisions = [];
        _revisionView = null;
        _autosaveAt = null;
        _autosaveStopped = false;
        _scheduleLocal = null;
        var flash = Saved switch
        {
            "draft" => "內容已建立為草稿，文字內容不對外公開。",
            "published" => "內容已建立並公開。",
            _ => null
        };
        await Load();
        // The marker belongs to the document that performed the save, not to other tabs.
        if (flash is not null) Notice = flash;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // The schedule input is interpreted in the visitor's own time zone.
        try { _timeZoneId = await JavaScript.InvokeAsync<string>("eval", "Intl.DateTimeFormat().resolvedOptions().timeZone"); }
        catch (JSException) { _timeZoneId = ""; }
        catch (InvalidOperationException) { /* No JS runtime during prerendering; keep UTC. */ }
        try { _tzOffsetMinutes = (int)await JavaScript.InvokeAsync<double>("eval", "-new Date().getTimezoneOffset()"); }
        catch (JSException) { _tzOffsetMinutes = 0; }
        catch (InvalidOperationException) { /* No JS runtime during prerendering; keep UTC. */ }
        // The zone is known now: show the stored schedule in the visitor's own wall clock.
        if (_model is not null && !_scheduleTouched) _scheduleLocal = ToLocalOffset(_model.PublishAt);
        if (_model?.Id is not null)
        {
            _autosaveCts = new CancellationTokenSource();
            _ = RunAutosaveLoopAsync(_autosaveCts.Token);
        }
        if (Saved is not null)
        {
            // Keep the result marker out of the address bar so a reload does not repeat it.
            try { await JavaScript.InvokeVoidAsync("history.replaceState", null, "", Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0]); }
            catch (JSException) { /* Best-effort address cleanup; the marker only repeats a notice. */ }
            catch (InvalidOperationException) { /* No JS runtime during prerendering; ignore. */ }
        }
    }
    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);
        if (!disposing) return;
        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();
        _autosaveCts = null;
    }
    private async Task RunAutosaveLoopAsync(CancellationToken cancellation)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Limits.AutosaveSeconds));
        try
        {
            while (!cancellation.IsCancellationRequested && await timer.WaitForNextTickAsync(cancellation))
            {
                await InvokeAsync(() => AutosaveTickAsync(cancellation));
            }
        }
        catch (OperationCanceledException) { /* The circuit closed; nothing to save into. */ }
        catch (ObjectDisposedException) { /* Component disposed while waiting on the timer. */ }
    }
    private async Task AutosaveTickAsync(CancellationToken cancellation)
    {
        // Autosave only touches existing drafts; anything else keeps the manual flow.
        if (_autosaveStopped || cancellation.IsCancellationRequested || Busy || SaveBlocked || ChildBusy
            || _model is not { Id: not null, Status: ContentStatus.Draft } || !Dirty) return;
        try
        {
            var input = BuildInput(ContentStatus.Draft);
            var sent = Snapshot(input);
            var sentVersion = input.Version;
            var saved = await Content.UpdateAsync(input, cancellation);
            if (_model is null) return;
            if (_model.Version != sentVersion)
            {
                // Another save replaced the editor model while this one was running; that result wins.
                return;
            }
            if (Snapshot(_model) != sent)
            {
                // The admin kept typing while the save was running: the newer text stays in the
                // editor and the next autosave carries it; only the new version is adopted.
                _model.Version = saved.Version;
                _baseline = sent;
                return;
            }
            _model = saved;
            _baseline = Snapshot(saved);
            _autosaveAt = DateTimeOffset.Now;
        }
        catch (CmsException)
        {
            // A conflict or validation failure must stop the loop; the manual flow shows the details.
            _autosaveStopped = true;
        }
        catch (UnauthorizedAccessException) { _autosaveStopped = true; }
        catch (OperationCanceledException) { /* The circuit is closing; the manual flow resumes next time. */ }
    }
    // The datetime-local picker yields wall-clock values; the browser's own time zone converts
    // them to UTC, so a date on the other side of a daylight-saving change keeps its wall clock.
    private DateTimeOffset? ToLocalOffset(DateTimeOffset? utc)
    {
        if (utc is not { } value) return null;
        return ScheduleTime.ToLocal(value, ResolveTimeZone());
    }
    private DateTimeOffset? FromLocalPick(DateTimeOffset? picked)
    {
        if (picked is not { } value) return null;
        return ScheduleTime.ToUtc(value, ResolveTimeZone());
    }
    /// <summary>The visitor's time zone; a fixed browser offset is the fallback when the zone is unknown.</summary>
    private TimeZoneInfo ResolveTimeZone() =>
        _timeZone ??= ScheduleTime.Resolve(_timeZoneId, TimeSpan.FromMinutes(_tzOffsetMinutes));
    private string PreviewUrl(Guid token) => Navigation.ToAbsoluteUri("/preview/" + token).ToString();
    private Task ToggleRevisions() => _revisionsOpen ? Task.CompletedTask : LoadRevisions();
    private Task LoadRevisions() => RunAsync(async ct =>
    {
        _revisions = await Content.ListRevisionsAsync(_model!.Id!.Value, ct);
        _revisionsOpen = true;
        _revisionView = null;
    });
    private Task ViewRevision(Guid revisionId) => RunAsync(async ct =>
    {
        _revisionView = await Content.GetRevisionAsync(revisionId, ct) ?? throw new CmsException("修訂記錄不存在，請重新載入。");
    });
    private Task RestoreRevisionById(Guid revisionId) => RunAsync(async ct =>
    {
        var revision = await Content.GetRevisionAsync(revisionId, ct) ?? throw new CmsException("修訂記錄不存在，請重新載入。");
        RestoreRevision(revision);
    });
    private void RestoreRevision(RevisionDetail revision)
    {
        // Restore loads the snapshot into the editor; nothing is written until the admin saves.
        _model!.Title = revision.Title;
        _model.Markdown = revision.Markdown;
        _model.Excerpt = revision.Excerpt;
        _revisionView = null;
        _preview = false;
    }
    private Task CyclePreview() => RunAsync(async ct =>
    {
        var token = await Content.CyclePreviewTokenAsync(_model!.Id!.Value, ct);
        // A share link is not a content edit: the editor keeps its own text and version, so a
        // concurrent save elsewhere still ends in a visible conflict instead of a silent overwrite.
        _model.PreviewToken = token;
    }, "預覽連結已產生；舊連結（若有）已失效。");
    private Task RevokePreview() => RunAsync(async ct =>
    {
        await Content.RevokePreviewTokenAsync(_model!.Id!.Value, ct);
        _model.PreviewToken = null;
    }, "預覽連結已撤銷。");
    private Task Load() => RunAsync(async ct =>
    {
        var loaded = Id is { } id ? await Content.GetEditAsync(id, ct) : new ContentEdit { Kind = InferNewKind() };
        _model = loaded;
        if (loaded.Kind == ContentKind.Page) _pageOptions = await Content.PageOptionsAsync(ct);
        _baseline = Snapshot(loaded);
        // The stored schedule belongs into the picker; the zone may still be unknown here and is
        // applied again once the browser reported it.
        _scheduleTouched = false;
        _scheduleLocal = ToLocalOffset(loaded.PublishAt);
        _preview = false;
    });

    private void ParentChanged(ChangeEventArgs args)
    {
        if (_model is null) return;
        _model.ParentId = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : null;
    }

    /// <summary>Parent candidates with an ancestor-path label; the page itself and its subtree are excluded.</summary>
    private List<(Guid Id, string Label)> ParentChoices()
    {
        if (_model is null) return [];
        var byId = _pageOptions.ToDictionary(x => x.Id);
        var children = _pageOptions.Where(x => x.ParentId is not null && byId.ContainsKey(x.ParentId.Value))
            .ToLookup(x => x.ParentId!.Value);
        HashSet<Guid> excluded = [];
        if (_model.Id is { } self)
        {
            var stack = new Stack<Guid>();
            stack.Push(self);
            while (stack.Count > 0)
                foreach (var child in children[stack.Pop()])
                    if (excluded.Add(child.Id)) stack.Push(child.Id);
        }
        string Label(PageOption page)
        {
            var parts = new List<string> { page.Title };
            var guard = 0;
            for (Guid? cursor = page.ParentId; cursor is { } current && byId.TryGetValue(current, out var node) && ++guard <= 10; cursor = node.ParentId)
                parts.Insert(0, node.Title);
            return string.Join(" › ", parts);
        }
        return [.. _pageOptions.Where(x => !excluded.Contains(x.Id)).Select(x => (x.Id, Label(x)))];
    }
    private void RequestReload() { if (!SaveBlocked) _reloadRequested = true; }
    private async Task Reload()
    {
        if (SaveBlocked) return;
        _reloadRequested = false;
        await Load();
    }
    private void ToggleMedia() { if (!Blocked && !_mediaBusy) _mediaOpen = !_mediaOpen; }
    private Task SaveCurrent() => Save(_model?.Status ?? ContentStatus.Draft);
    private ContentEdit BuildInput(ContentStatus status) => new()
    {
        Id = _model!.Id, Kind = _model.Kind, Title = _model.Title, Slug = _model.Slug,
        Markdown = _model.Markdown, Excerpt = _model.Excerpt, IsSticky = _model.IsSticky,
        IsProtected = _model.IsProtected, IsPrivate = _model.IsPrivate, NewProtectPassword = _protectPassword,
        ParentId = _model.Kind == ContentKind.Page ? _model.ParentId : null,
        PublishAt = status == ContentStatus.Draft ? FromLocalPick(_scheduleLocal) : null,
        Version = _model.Version, Status = status,
        CategoryIds = [.. _model.CategoryIds], TagIds = [.. _model.TagIds]
    };
    private async Task Save(ContentStatus status)
    {
        if (_model is null || SaveBlocked) return;
        ContentEdit input;
        try { input = BuildInput(status); }
        catch (CmsException error) { Error = error.Message; return; }
        var isNew = input.Id is null;
        var wasPublished = _model.Status == ContentStatus.Published;
        var success = await RunAsync(async ct =>
        {
            ContentRules.Validate(input);
            // The server decides the content kind; a submitted kind is only used when creating.
            _model = isNew
                ? await Content.CreateAsync(input.Kind, input, ct)
                : await Content.UpdateAsync(input, ct);
            _baseline = Snapshot(_model);
            _scheduleTouched = false;
            _scheduleLocal = ToLocalOffset(_model.PublishAt);
        }, SaveNotice(status, wasPublished));
        if (success && isNew && _model.Id is { } id)
        {
            // A new content identifier changes this page's route. A document-level
            // navigation guarantees a fresh component instance bound to the stored version.
            var target = "/admin/content/" + id + "?saved=" + (status == ContentStatus.Published ? "published" : "draft");
            try { await JavaScript.InvokeVoidAsync("location.replace", target); }
            catch (JSException) { /* The save already succeeded; the user can still navigate manually. */ }
            catch (InvalidOperationException) { /* No JS runtime during prerendering; ignore. */ }
        }
    }
    private Task Preview() => SaveBlocked ? Task.CompletedTask : RunAsync(ct =>
    {
        _previewHtml = MarkdownRenderer.Render(_model?.Markdown ?? "");
        _preview = true;
        return Task.CompletedTask;
    });
    private void InsertMedia(MediaItem item)
    {
        if (_model is null || Blocked) return;
        if ((_model.Markdown?.Length ?? 0) + item.Markdown.Length + 4 > Limits.Body)
        { Error = "插入圖片後將超過本文長度上限，請先縮短內容。"; return; }
        _model.Markdown = (_model.Markdown ?? "").TrimEnd() + "\n\n" + item.Markdown + "\n\n";
        _preview = false;
        _mediaOpen = false;
    }
    private void SelectionChanged() => StateHasChanged();
}
