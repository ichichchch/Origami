@page "/admin/comments"
@rendermode InteractiveServer
@attribute [Authorize]
@layout AdminLayout
@inherits AdminComponentBase
@inject OrigamiClient Api

<PageTitle>@UiText.T("Admin.Comments.PageTitle", "評論 · 內容管理")</PageTitle>
<UnsavedGuard Busy="Busy" />
<div class="page-heading"><div><p class="eyebrow">@UiText.T("Admin.Comments.Eyebrow", "社群互動")</p><h1>@UiText.T("Admin.Comments.Title", "評論")</h1><p>@UiText.T("Admin.Comments.Introduction", "審核訪客評論：核可後才會公開顯示；蜜罐與連結過量者會自動進入垃圾佇列。")</p></div></div>
<AdminFeedback Busy="Busy" Error="@Error" Notice="@Notice" LoginRequired="LoginRequired" />
@if (_counts is null)
{
    @if (Error is null)
    {
        <p role="status">@UiText.T("Admin.Comments.Loading", "正在載入評論…")</p>
    }
    else
    {
        <button type="button" class="button button-secondary" disabled="@Blocked" @onclick="LoadAsync">@UiText.T("Common.Reload", "重新載入")</button>
    }
}
else
{
    <div class="section-tabs" role="group" aria-label="@UiText.T("Admin.Comments.StatusFilter", "評論狀態篩選")">
        <button type="button" class="tab-button @(_status is null ? "active" : "")" aria-pressed="@((_status is null).ToString().ToLowerInvariant())" disabled="@Blocked" @onclick="() => ChangeStatus(null)">@UiText.T("Admin.Comments.All", "全部") <span class="count">@TotalCount</span></button>
        <button type="button" class="tab-button @(_status == CommentStatus.Pending ? "active" : "")" aria-pressed="@((_status == CommentStatus.Pending).ToString().ToLowerInvariant())" disabled="@Blocked" @onclick="() => ChangeStatus(CommentStatus.Pending)">@UiText.T("Admin.Comments.Pending", "待審") <span class="count">@_counts.Pending</span></button>
        <button type="button" class="tab-button @(_status == CommentStatus.Approved ? "active" : "")" aria-pressed="@((_status == CommentStatus.Approved).ToString().ToLowerInvariant())" disabled="@Blocked" @onclick="() => ChangeStatus(CommentStatus.Approved)">@UiText.T("Admin.Comments.Approved", "已核可") <span class="count">@_counts.Approved</span></button>
        <button type="button" class="tab-button @(_status == CommentStatus.Spam ? "active" : "")" aria-pressed="@((_status == CommentStatus.Spam).ToString().ToLowerInvariant())" disabled="@Blocked" @onclick="() => ChangeStatus(CommentStatus.Spam)">@UiText.T("Admin.Comments.Spam", "垃圾") <span class="count">@_counts.Spam</span></button>
        <button type="button" class="tab-button @(_status == CommentStatus.Trashed ? "active" : "")" aria-pressed="@((_status == CommentStatus.Trashed).ToString().ToLowerInvariant())" disabled="@Blocked" @onclick="() => ChangeStatus(CommentStatus.Trashed)">@UiText.T("Admin.Comments.Trash", "垃圾桶") <span class="count">@_counts.Trashed</span></button>
    </div>
    @if (_result is not null)
    {
        @if (_result.Items.Count == 0)
        {
            <section class="empty-state"><span class="empty-symbol" aria-hidden="true">—</span><h2>@UiText.T("Admin.Comments.EmptyTitle", "沒有符合條件的評論")</h2><p>@UiText.T("Admin.Comments.EmptyHelp", "訪客在已發布文章留言後，會出現在待審佇列。")</p></section>
        }
        else
        {
            @if (_selected.Count > 0)
            {
                <div class="bulk-bar" role="group" aria-label="@UiText.T("Admin.Comments.BulkActions", "批次操作")">
                    <span class="bulk-count">@string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.SelectedCount", "已選 {0} 則"), _selected.Count)</span>
                    <div class="button-row">
                        <button type="button" class="button button-secondary button-small" disabled="@EditBlocked" @onclick="() => BulkAsync(CommentStatus.Approved)">@UiText.T("Admin.Comments.BulkApprove", "批次核可")</button>
                        <button type="button" class="button button-secondary button-small" disabled="@EditBlocked" @onclick="() => BulkAsync(CommentStatus.Spam)">@UiText.T("Admin.Comments.BulkSpam", "批次標記垃圾")</button>
                        <button type="button" class="button button-secondary button-small" disabled="@EditBlocked" @onclick="() => BulkAsync(CommentStatus.Trashed)">@UiText.T("Admin.Comments.BulkTrash", "批次移入垃圾桶")</button>
                        <button type="button" class="button button-danger button-small" disabled="@EditBlocked" @onclick="() => _pendingBulkDelete = true">@UiText.T("Admin.Comments.BulkDelete", "批次永久刪除")</button>
                        <button type="button" class="text-button" disabled="@EditBlocked" @onclick="ClearSelection">@UiText.T("Admin.Comments.ClearSelection", "取消選取")</button>
                    </div>
                </div>
            }
            <section class="panel"><div class="table-scroll"><table><caption class="sr-only">@UiText.T("Admin.Comments.ListCaption", "評論列表")</caption><thead><tr><th scope="col" class="select-cell"><label class="sr-only" for="comment-select-all">@UiText.T("Admin.Comments.SelectPage", "全選本頁")</label><input id="comment-select-all" type="checkbox" checked="@AllPageSelected" @onchange="ToggleAll" disabled="@EditBlocked" /></th><th scope="col">@UiText.T("Admin.Comments.AuthorAndTime", "訪客 / 時間")</th><th scope="col">@UiText.T("Admin.Comments.CommentBody", "評論內容")</th><th scope="col">@UiText.T("Admin.Comments.Status", "狀態")</th><th scope="col">@UiText.T("Admin.Comments.Actions", "操作")</th></tr></thead><tbody>
            @foreach (var comment in _result.Items)
            {
                <tr @key="comment.Id">
                    <td class="select-cell"><label class="sr-only" for="@("comment-select-" + comment.Id)">@string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.SelectComment", "選擇 {0} 的評論"), comment.AuthorName)</label><input id="@("comment-select-" + comment.Id)" type="checkbox" checked="@_selected.Contains(comment.Id)" @onchange="e => ToggleSelect(comment.Id, e)" disabled="@EditBlocked" /></td>
                    <td class="date-cell">
                        <strong>@comment.AuthorName</strong>
                        @if (comment.IsAdminReply) { <span class="status-badge published">@UiText.T("Admin.Comments.OfficialReply", "官方回覆")</span> }
                        @if (comment.Url.Length > 0) { <br /><small class="slug-text">@comment.Url</small> }
                        <small>@comment.CreatedAt.ToString("yyyy.MM.dd HH:mm") UTC</small>
                    </td>
                    <td class="title-cell">
                        <span class="slug-text">@string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.OnContent", "於「{0}」"), comment.ContentTitle)@if (!string.IsNullOrEmpty(comment.ParentAuthorName)) { <text> · @string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.ReplyTo", "回覆 {0}"), comment.ParentAuthorName)</text> }</span>
                        <div class="comment-body">@MarkdownPreview(comment.Markdown)</div>
                        @if (comment.IsEdited) { <span class="slug-text">@UiText.T("Admin.Comments.EditedBadge", "已編輯")</span> }
                        @if (!comment.IsAdminReply)
                        {
                            @if (_editingId == comment.Id)
                            {
                                <div class="reply-box">
                                    <label class="sr-only" for="@("admin-edit-" + comment.Id)">@UiText.T("Admin.Comments.EditLabel", "評論內容")</label>
                                    <textarea id="@("admin-edit-" + comment.Id)" rows="3" maxlength="@Limits.CommentBody" @bind="_editBody" @bind:event="oninput" disabled="@EditBlocked"></textarea>
                                    <div class="button-row">
                                        <button type="button" class="button button-small" disabled="@(EditBlocked || string.IsNullOrWhiteSpace(_editBody))" @onclick="() => SubmitEditAsync(comment)">@UiText.T("Admin.Comments.SaveEdit", "儲存修改")</button>
                                        <button type="button" class="button button-secondary button-small" disabled="@EditBlocked" @onclick="CancelEdit">@UiText.T("Admin.Comments.Cancel", "取消")</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="text-button" disabled="@EditBlocked" @onclick="() => StartEdit(comment)">@UiText.T("Admin.Comments.Edit", "編輯")<span class="sr-only"> @string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.AuthorOf", "{0} 的評論"), comment.AuthorName)</span></button>
                            }
                        }
                        @if (_replyingToId == comment.Id)
                        {
                            <div class="reply-box">
                                <label class="sr-only" for="@("admin-reply-" + comment.Id)">@UiText.T("Admin.Comments.ReplyLabel", "回覆內容")</label>
                                <textarea id="@("admin-reply-" + comment.Id)" rows="3" maxlength="@Limits.CommentBody" @bind="_replyBody" @bind:event="oninput" placeholder="@UiText.T("Admin.Comments.ReplyPlaceholder", "輸入回覆內容（支援 Markdown）…")" disabled="@EditBlocked"></textarea>
                                <div class="button-row">
                                    <button type="button" class="button button-small" disabled="@(EditBlocked || string.IsNullOrWhiteSpace(_replyBody))" @onclick="() => SubmitReplyAsync(comment.Id)">@UiText.T("Admin.Comments.SubmitReply", "送出回覆")</button>
                                    <button type="button" class="button button-secondary button-small" disabled="@EditBlocked" @onclick="CancelReply">@UiText.T("Admin.Comments.Cancel", "取消")</button>
                                </div>
                            </div>
                        }
                    </td>
                    <td><span class="status-badge @(comment.Status == CommentStatus.Approved ? "published" : "draft")">@StatusText(comment.Status)</span></td>
                    <td><div class="table-actions">
                        @if (comment.Status != CommentStatus.Approved)
                        {
                            <button disabled="@EditBlocked" @onclick="() => ModerateAsync(comment, CommentStatus.Approved)">@UiText.T("Admin.Comments.Approve", "核可")<span class="sr-only"> @string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.AuthorComment", "{0} 的評論"), comment.AuthorName)</span></button>
                        }
                        @if (comment.Status == CommentStatus.Approved || comment.Status == CommentStatus.Pending)
                        {
                            <button class="text-button" disabled="@EditBlocked" @onclick="() => BeginReply(comment.Id)">@UiText.T("Admin.Comments.Reply", "回覆")<span class="sr-only"> @string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.AuthorComment", "{0} 的評論"), comment.AuthorName)</span></button>
                        }
                        @if (comment.Status != CommentStatus.Spam)
                        {
                            <button class="text-button" disabled="@EditBlocked" @onclick="() => ModerateAsync(comment, CommentStatus.Spam)">@UiText.T("Admin.Comments.MarkSpam", "標記垃圾")<span class="sr-only"> @string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.AuthorComment", "{0} 的評論"), comment.AuthorName)</span></button>
                        }
                        @if (comment.Status == CommentStatus.Spam || comment.Status == CommentStatus.Trashed)
                        {
                            <button class="text-button" disabled="@EditBlocked" @onclick="() => ModerateAsync(comment, CommentStatus.Pending)">@UiText.T("Admin.Comments.ReturnToPending", "退回待審")<span class="sr-only"> @string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.AuthorComment", "{0} 的評論"), comment.AuthorName)</span></button>
                            <button class="text-danger" disabled="@EditBlocked" @onclick="() => _pendingDelete = comment">@UiText.T("Admin.Comments.DeletePermanently", "永久刪除")<span class="sr-only"> @string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.AuthorComment", "{0} 的評論"), comment.AuthorName)</span></button>
                        }
                        else
                        {
                            <button class="text-button" disabled="@EditBlocked" @onclick="() => ModerateAsync(comment, CommentStatus.Trashed)">@UiText.T("Admin.Comments.Trash", "垃圾桶")<span class="sr-only"> @string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.AuthorComment", "{0} 的評論"), comment.AuthorName)</span></button>
                        }
                    </div></td>
                </tr>
            }
            </tbody></table></div>
            <nav class="pagination" aria-label="@UiText.T("Admin.Comments.Pagination", "評論分頁")"><button class="button button-secondary" disabled="@(Blocked || _page <= 1)" @onclick="() => Move(-1)">@UiText.T("Admin.Comments.PreviousPage", "上一頁")</button><span>@_result.Page / @_result.TotalPages</span><button class="button button-secondary" disabled="@(Blocked || _page >= _result.TotalPages)" @onclick="() => Move(1)">@UiText.T("Admin.Comments.NextPage", "下一頁")</button></nav>
            </section>
        }
    }
}
@if (_pendingBulkDelete)
{
    <section class="notice notice-danger" role="alertdialog" aria-labelledby="comment-bulk-delete-title">
        <h2 id="comment-bulk-delete-title">@string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.BulkDeleteTitle", "永久刪除所選的 {0} 則評論？"), _selected.Count)</h2>
        <p>@UiText.T("Admin.Comments.BulkDeleteWarning", "永久刪除無法復原。")</p>
        <div class="button-row"><button class="button button-danger" disabled="@Blocked" @onclick="BulkDelete">@UiText.T("Admin.Comments.ConfirmDelete", "確認刪除")</button><button class="button button-secondary" disabled="@Blocked" @onclick="() => _pendingBulkDelete = false">@UiText.T("Admin.Comments.Cancel", "取消")</button></div>
    </section>
}
@if (_pendingDelete is not null)
{
    <section class="notice notice-danger" role="alertdialog" aria-labelledby="comment-delete-title">
        <h2 id="comment-delete-title">@UiText.T("Admin.Comments.DeleteTitle", "永久刪除這則評論？")</h2>
        <p>@string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Comments.DeleteWarning", "評論由「{0}」發表於「{1}」。永久刪除無法復原。"), _pendingDelete.AuthorName, _pendingDelete.ContentTitle)</p>
        <div class="button-row"><button class="button button-danger" disabled="@Blocked" @onclick="DeleteAsync">@UiText.T("Admin.Comments.ConfirmDelete", "確認刪除")</button><button class="button button-secondary" disabled="@Blocked" @onclick="() => _pendingDelete = null">@UiText.T("Admin.Comments.Cancel", "取消")</button></div>
    </section>
}

@code {
    private int _page = 1;
    private CommentStatus? _status;
    private PagedResult<CommentService.CommentView>? _result;
    private CommentService.CommentCounts? _counts;
    private CommentService.CommentView? _pendingDelete;
    private Guid? _replyingToId;
    private string _replyBody = "";
    // 批次選取僅對目前頁面快照有效：版本號取自當前列表，換頁、重篩選或操作後清空。
    private readonly HashSet<Guid> _selected = [];
    private bool _pendingBulkDelete;
    private Guid? _editingId;
    private string _editBody = "";
    private bool AllPageSelected => _result is not null && _result.Items.Count > 0 && _result.Items.All(x => _selected.Contains(x.Id));
    private int TotalCount => _counts is null ? 0 : _counts.Pending + _counts.Approved + _counts.Spam + _counts.Trashed;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task LoadAsync() => RunAsync(LoadDataAsync);

    private async Task LoadDataAsync(CancellationToken ct)
    {
        var counts = await Api.GetCommentCountsAsync(ct);
        var result = await Api.ListCommentsAsync(_status, _page, ct);
        var page = Math.Min(_page, Math.Max(1, result?.TotalPages ?? 1));
        if (page != _page) result = await Api.ListCommentsAsync(_status, page, ct);
        _counts = counts;
        _result = result;
        _page = page;
    }

    private async Task ChangeStatus(CommentStatus? status)
    {
        if (Blocked) return;
        var previous = (_status, _page);
        _status = status;
        _page = 1;
        _selected.Clear();
        CancelEdit();
        if (!await RunAsync(LoadDataAsync)) (_status, _page) = previous;
    }

    private async Task Move(int delta)
    {
        if (Blocked) return;
        var previous = _page;
        _page += delta;
        if (!await RunAsync(LoadDataAsync)) _page = previous;
    }

    private Task ModerateAsync(CommentService.CommentView comment, CommentStatus target) => RunEditAsync(async ct =>
    {
        await Api.ModerateCommentAsync(comment.Id, target, comment.Version, ct);
        await LoadDataAsync(ct);
    }, UiText.T("Admin.Comments.StatusUpdated", "評論狀態已更新。"));

    private void ToggleSelect(Guid id, ChangeEventArgs args)
    {
        if (args.Value is true) _selected.Add(id);
        else _selected.Remove(id);
    }

    private void ToggleAll(ChangeEventArgs args)
    {
        _selected.Clear();
        if (args.Value is true && _result is not null)
            foreach (var comment in _result.Items) _selected.Add(comment.Id);
    }

    private void ClearSelection()
    {
        _selected.Clear();
        _pendingBulkDelete = false;
    }

    private List<(Guid Id, Guid Version)> SelectedItems() =>
        [.. (_result?.Items ?? []).Where(x => _selected.Contains(x.Id)).Select(x => (x.Id, x.Version))];

    private async Task BulkAsync(CommentStatus target)
    {
        if (Blocked) return;
        var items = SelectedItems();
        var ok = await RunEditAsync(async ct =>
        {
            var results = await Api.BulkModerateCommentsAsync(items, target, ct)
                ?? throw new CmsException(UiText.T("Admin.Comments.BulkFailed", "批次操作無法執行，請重試。"));
            _selected.Clear();
            await LoadDataAsync(ct);
            var failed = results.Where(x => !x.Succeeded).ToList();
            if (failed.Count > 0)
                throw new CmsException(string.Format(CultureInfo.CurrentCulture,
                    UiText.T("Admin.Comments.BulkPartial", "批次處理完成：成功 {0} 則、失敗 {1} 則。例：{2}"),
                    results.Count - failed.Count, failed.Count, failed[0].Message));
        }, UiText.T("Admin.Comments.BulkDone", "批次處理完成。"));
        if (!ok) _selected.Clear();
    }

    /// <summary>批次永久刪除：逐一刪除並回報；需先在頁內確認，單則失敗不中斷其餘。</summary>
    private Task BulkDelete() => RunEditAsync(async ct =>
    {
        var items = SelectedItems();
        var failed = 0;
        string? firstError = null;
        foreach (var (id, version) in items)
        {
            try { await Api.DeleteCommentAsync(id, version, ct); }
            catch (CmsException error)
            {
                failed++;
                firstError ??= error.Message;
            }
        }
        _selected.Clear();
        _pendingBulkDelete = false;
        await LoadDataAsync(ct);
        if (failed > 0)
            throw new CmsException(string.Format(CultureInfo.CurrentCulture,
                UiText.T("Admin.Comments.BulkPartial", "批次處理完成：成功 {0} 則、失敗 {1} 則。例：{2}"), items.Count - failed, failed, firstError ?? ""));
    }, UiText.T("Admin.Comments.BulkDeleted", "已批次永久刪除所選評論。"));

    private void StartEdit(CommentService.CommentView comment)
    {
        _editingId = comment.Id;
        _editBody = comment.Markdown;
        _replyingToId = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editBody = "";
    }

    private Task SubmitEditAsync(CommentService.CommentView comment) => RunEditAsync(async ct =>
    {
        await Api.UpdateCommentAsync(comment.Id, _editBody, comment.Version, ct);
        _editingId = null;
        _editBody = "";
        await LoadDataAsync(ct);
    }, UiText.T("Admin.Comments.EditSaved", "評論內容已修改，並標示為已編輯。"));

    private void BeginReply(Guid commentId)
    {
        _replyingToId = commentId;
        _replyBody = "";
        CancelEdit();
    }

    private void CancelReply()
    {
        _replyingToId = null;
        _replyBody = "";
    }

    private Task SubmitReplyAsync(Guid commentId) => RunEditAsync(async ct =>
    {
        await Api.ReplyCommentAsync(commentId, _replyBody, ct);
        _replyingToId = null;
        _replyBody = "";
        await LoadDataAsync(ct);
    }, UiText.T("Admin.Comments.Replied", "回覆已發表並公開顯示。"));

    private async Task DeleteAsync()
    {
        if (_pendingDelete is not { } comment) return;
        await RunEditAsync(async ct =>
        {
            await Api.DeleteCommentAsync(comment.Id, comment.Version, ct);
            _pendingDelete = null;
            await LoadDataAsync(ct);
        }, UiText.T("Admin.Comments.Deleted", "評論已永久刪除。"));
    }

    private static string StatusText(CommentStatus status) => status switch
    {
        CommentStatus.Approved => UiText.T("Admin.Comments.Approved", "已核可"),
        CommentStatus.Spam => UiText.T("Admin.Comments.Spam", "垃圾"),
        CommentStatus.Trashed => UiText.T("Admin.Comments.Trash", "垃圾桶"),
        _ => UiText.T("Admin.Comments.Pending", "待審")
    };

    private static string MarkdownPreview(string body) =>
        body.Length <= 160 ? body : body[..160] + "…";
}
