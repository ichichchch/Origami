@page "/admin/credentials"
@rendermode InteractiveServer
@attribute [Authorize]
@layout AdminLayout
@inherits AdminComponentBase
@inject OrigamiClient Api
@inject IJSRuntime JavaScript
@inject TimeProvider Clock

<PageTitle>@UiText.T("Admin.Credentials.PageTitle", "API 憑證 · 內容管理")</PageTitle>
<div class="page-heading"><div><p class="eyebrow">@UiText.T("Admin.Credentials.Eyebrow", "個人外部存取")</p><h1>@UiText.T("Admin.Credentials.Title", "API 憑證")</h1><p>@UiText.T("Admin.Credentials.Introduction", "憑證只代表目前登入者及本站，權限不會超過持有者當前角色。不是網站的 BFF 服務憑證。")</p></div></div>
<AdminFeedback Busy="Busy" Error="@Error" Notice="@Notice" LoginRequired="LoginRequired" />
<button class="button button-secondary" disabled="@Blocked" @onclick="Load">@UiText.T("Admin.Credentials.Reload", "重新載入憑證")</button>
@if (_secret is not null)
{
    <section class="notice notice-success" aria-labelledby="credential-secret-title">
        <h2 id="credential-secret-title">@UiText.T("Admin.Credentials.SecretTitle", "請立即保存：秘密只顯示這一次")</h2>
        <p>@string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Credentials.SecretExpiry", "到期時間：{0}。隱藏、離開或重新載入頁面後無法再次取得；遺失請撤銷並重建。"), _createdExpiry.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'"))</p>
        <label for="credential-secret">@UiText.T("Admin.Credentials.NewCredential", "新憑證")</label><input id="credential-secret" class="code-input" value="@_secret" readonly autocomplete="off" spellcheck="false" />
        <div class="button-row"><button class="button" disabled="@Blocked" @onclick="Copy">@UiText.T("Admin.Credentials.Copy", "複製憑證")</button><button class="button button-secondary" @onclick="Hide">@UiText.T("Admin.Credentials.Hide", "隱藏並清除")</button></div>
        <p class="field-help">@UiText.T("Admin.Credentials.SecretHelp", "不寫入瀏覽器儲存空間。請勿貼入原始碼、網址、日誌或對話；複製會使用你的系統剪貼簿。")</p>
    </section>
}
@if (Access?.CanRead == true)
{
    <section class="panel settings-panel settings-width">
        <h2>@UiText.T("Admin.Credentials.Create", "建立憑證")</h2>
        <EditForm Model="_input" OnSubmit="Create" FormName="credential-create">
            <fieldset disabled="@(Blocked || _secret is not null)">
                <div class="field"><label for="credential-name">@UiText.T("Admin.Credentials.Purpose", "用途名稱")</label><input id="credential-name" @bind="_input.Name" maxlength="@Limits.CredentialName" required /></div>
                <div class="field"><label for="credential-scope">@UiText.T("Admin.Credentials.Scope", "範圍")</label><InputSelect id="credential-scope" @bind-Value="_input.Scope"><option value="Read">@UiText.T("Admin.Credentials.ReadScope", "Read（唯讀）")</option>@if (CanEdit) { <option value="Write">@UiText.T("Admin.Credentials.WriteScope", "Write（內容讀寫）")</option> }</InputSelect></div>
                <div class="field"><label for="credential-days">@UiText.T("Admin.Credentials.ValidDays", "有效天數")</label><input id="credential-days" type="number" @bind="_days" min="1" max="365" required /><span class="field-help">@UiText.T("Admin.Credentials.ValidDaysHelp", "預設 90 天，最多 365 天；到期自動失效。")</span></div>
                <button class="button" type="submit">@UiText.T("Admin.Credentials.Create", "建立憑證")</button>
            </fieldset>
        </EditForm>
    </section>
}
@if (_credentials is not null)
{
    <section class="panel"><div class="table-scroll"><table><caption>@UiText.T("Admin.Credentials.TableCaption", "本人在本站的憑證")</caption>
        <thead><tr><th>@UiText.T("Admin.Credentials.Name", "名稱")</th><th>@UiText.T("Admin.Credentials.Scope", "範圍")</th><th>@UiText.T("Admin.Credentials.CreatedAt", "建立時間（UTC）")</th><th>@UiText.T("Admin.Credentials.ExpiresAt", "到期時間（UTC）")</th><th>@UiText.T("Admin.Credentials.Status", "狀態")</th><th>@UiText.T("Admin.Credentials.Actions", "操作")</th></tr></thead><tbody>
        @foreach (var credential in _credentials)
        {
            <tr @key="credential.Id"><td>@credential.Name</td><td>@credential.Scope</td><td>@credential.CreatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@credential.ExpiresAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@State(credential)</td>
                <td><button class="text-danger" disabled="@(Blocked || credential.RevokedAt is not null)" @onclick="() => _pending = credential">@UiText.T("Admin.Credentials.Revoke", "撤銷")</button></td></tr>
        }
        </tbody></table></div><p class="field-help">@UiText.T("Admin.Credentials.RevalidationHelp", "密碼重設、帳號停用或成員權限變更也可能使憑證失效；實際權限由伺服器每次請求重驗。")</p></section>
}
@if (_pending is { } pending)
{
    <section class="notice notice-danger" role="alertdialog" aria-labelledby="credential-revoke-title">
        <h2 id="credential-revoke-title">@string.Format(CultureInfo.CurrentCulture, UiText.T("Admin.Credentials.RevokeTitle", "撤銷「{0}」？"), pending.Name)</h2><p>@UiText.T("Admin.Credentials.RevokeHelp", "使用此憑證的應用程式會立即失去存取權，且無法恢復此憑證。")</p>
        <button class="button button-danger" disabled="@Blocked" @onclick="Revoke">@UiText.T("Admin.Credentials.ConfirmRevoke", "確認撤銷")</button><button class="button button-secondary" disabled="@Blocked" @onclick="() => _pending = null">@UiText.T("Admin.Credentials.Cancel", "取消")</button>
    </section>
}

@code {
    private CredentialCreateInput _input = new();
    private List<CredentialSummary>? _credentials;
    private CredentialSummary? _pending;
    private int _days = 90;
    private string? _secret;
    private Guid? _createdId;
    private DateTimeOffset _createdExpiry;
    protected override Task OnInitializedAsync() => Load();
    private Task Load() => RunAsync(async ct => { _credentials = await Api.ListCredentialsAsync(ct); });
    private string State(CredentialSummary credential) => credential.RevokedAt is not null ? UiText.T("Admin.Credentials.RevokedState", "已撤銷") :
        credential.ExpiresAt <= Clock.GetUtcNow() ? UiText.T("Admin.Credentials.ExpiredState", "已到期") : UiText.T("Admin.Credentials.UnexpiredState", "未到期");
    private Task Create() => RunAsync(async ct =>
    {
        if (_secret is not null) throw new CmsException(UiText.T("Admin.Credentials.SaveSecretFirst", "請先保存並隱藏目前顯示的新憑證。"));
        if (_days is < 1 or > 365) throw new CmsException(UiText.T("Admin.Credentials.InvalidDays", "有效天數須為 1–365 天。"));
        if (_input.Scope == ApiCredentialScope.Write && !CanEdit) throw new AccessDeniedException(UiText.T("Admin.Credentials.WriteDenied", "唯讀成員不能建立寫入憑證。"));
        _input.ExpiresAt = Clock.GetUtcNow().AddDays(_days);
        var created = await Api.CreateCredentialAsync(_input, ct);
        _secret = created.Token;
        _createdId = created.Id;
        _createdExpiry = created.ExpiresAt;
        _input = new();
        _credentials = await Api.ListCredentialsAsync(ct);
    });
    private async Task Copy()
    {
        if (Blocked || _secret is null) return;
        try
        {
            await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", Lifetime.Token, _secret);
            Notice = UiText.T("Admin.Credentials.Copied", "已複製至剪貼簿，保存後請隱藏並清除。");
        }
        catch (JSException) { Error = UiText.T("Admin.Credentials.CopyFailed", "無法存取剪貼簿，請手動選取並複製。"); }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
    }
    private void Hide() { _secret = null; _createdId = null; }
    private Task Revoke() => RunAsync(async ct =>
    {
        if (_pending is not { } credential) return;
        await Api.RevokeCredentialAsync(credential.Id, ct);
        if (_createdId == credential.Id) Hide();
        _pending = null;
        _credentials = await Api.ListCredentialsAsync(ct);
    }, UiText.T("Admin.Credentials.Revoked", "憑證已撤銷。"));
    protected override void Dispose(bool disposing)
    {
        Hide();
        base.Dispose(disposing);
    }
}
