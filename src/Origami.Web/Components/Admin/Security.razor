@page "/admin/security"
@rendermode InteractiveServer
@attribute [Authorize]
@layout AdminLayout
@inherits AdminComponentBase
@inject TwoFactorService TwoFactor
@inject OrigamiClient Api

<PageTitle>@UiText.T("Admin.Security.PageTitle", "個人資料與安全 · 內容管理")</PageTitle>
<UnsavedGuard Busy="Busy" />
<div class="page-heading"><div><p class="eyebrow">@UiText.T("Admin.Security.Eyebrow", "帳號與作者名片")</p><h1>@UiText.T("Admin.Security.Title", "個人資料與安全設定")</h1><p>@UiText.T("Admin.Security.Introduction", "管理你的公開作者介紹、修改登入密碼，或啟用兩步驟驗證（TOTP）。")</p></div></div>
<AdminFeedback Busy="Busy" Error="@Error" Notice="@Notice" LoginRequired="LoginRequired" />
@if (_profile is not null)
{
    <div class="management-grid">
        <section class="panel settings-panel">
            <div class="panel-intro">
                <h2>@UiText.T("Admin.Security.ProfileTitle", "公開作者資料")</h2>
                <p>@UiText.T("Admin.Security.ProfileHelp", "顯示於你的文章署名與作者彙整頁（/author/代稱）。")</p>
            </div>
            <EditForm Model="_profile" OnValidSubmit="SaveProfileAsync" FormName="account-profile">
                <DataAnnotationsValidator />
                <fieldset disabled="@Blocked">
                    <div class="field">
                        <label for="profile-username">@UiText.T("Admin.Security.UserName", "登入帳號")</label>
                        <input id="profile-username" value="@_profile.UserName" readonly disabled />
                    </div>
                    <div class="field">
                        <label for="profile-display-name">@UiText.T("Admin.Security.DisplayName", "本站公開顯示名稱")</label>
                        <input id="profile-display-name" maxlength="@Limits.AuthorName" @bind="_profile.DisplayName" @bind:event="oninput" />
                        <span class="field-help">@UiText.T("Admin.Security.DisplayNameHelp", "更改後會同步更新你在本站已發表文章的署名與作者頁代稱。")</span>
                    </div>
                    <div class="field">
                        <label for="profile-email">@UiText.T("Admin.Security.Email", "電子郵件（供密碼重設）")</label>
                        <input id="profile-email" type="email" maxlength="256" @bind="_profile.Email" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label for="profile-website">@UiText.T("Admin.Security.WebsiteUrl", "個人網站（選填）")</label>
                        <input id="profile-website" type="url" maxlength="@Limits.UserUrl" @bind="_profile.WebsiteUrl" @bind:event="oninput" placeholder="https://" />
                    </div>
                    <div class="field">
                        <label for="profile-avatar">@UiText.T("Admin.Security.AvatarUrl", "頭像網址（選填）")</label>
                        <input id="profile-avatar" maxlength="@Limits.UserUrl" @bind="_profile.AvatarUrl" @bind:event="oninput" placeholder="/media/... 或 https://..." />
                    </div>
                    <div class="field">
                        <label for="profile-bio">@UiText.T("Admin.Security.Bio", "作者簡介（Bio）")</label>
                        <textarea id="profile-bio" rows="3" maxlength="@Limits.UserBio" @bind="_profile.Bio" @bind:event="oninput"></textarea>
                    </div>
                    <button type="submit" class="button" disabled="@Blocked">@UiText.T("Admin.Security.SaveProfile", "儲存個人資料")</button>
                </fieldset>
            </EditForm>
        </section>

        <section class="panel settings-panel">
            <div class="panel-intro">
                <h2>@UiText.T("Admin.Security.ChangePasswordTitle", "修改登入密碼")</h2>
                <p>@UiText.T("Admin.Security.ChangePasswordHelp", "至少 8 字元，需包含大小寫字母、數字、符號及至少 4 種不同字元。")</p>
            </div>
            <EditForm Model="_passwordForm" OnValidSubmit="ChangePasswordAsync" FormName="account-password">
                <DataAnnotationsValidator />
                <fieldset disabled="@Blocked">
                    <div class="field">
                        <label for="pwd-current">@UiText.T("Admin.Security.CurrentPassword", "目前密碼")</label>
                        <input id="pwd-current" type="password" maxlength="1024" @bind="_passwordForm.CurrentPassword" required autocomplete="current-password" />
                    </div>
                    <div class="field">
                        <label for="pwd-new">@UiText.T("Admin.Security.NewPassword", "新密碼")</label>
                        <input id="pwd-new" type="password" maxlength="1024" @bind="_passwordForm.NewPassword" required autocomplete="new-password" />
                    </div>
                    <button type="submit" class="button" disabled="@Blocked">@UiText.T("Admin.Security.UpdatePassword", "更新密碼")</button>
                </fieldset>
            </EditForm>
        </section>
    </div>
}
@if (_status is not null)
{
    <section class="panel settings-panel settings-width">
        <div class="panel-intro">
            <h2>@UiText.T("Admin.Security.TotpTitle", "兩步驟驗證（TOTP）")</h2>
            @if (_status.Enabled)
            {
                <p>@UiText.T("Admin.Security.EnabledHelp", "目前已啟用。登入時除密碼外，需輸入動態驗證碼。")</p>
            }
            else if (_status.SetupPending)
            {
                <p>@UiText.T("Admin.Security.PendingHelp", "已有待確認的設定金鑰；重新開始會更換金鑰。")</p>
            }
            else
            {
                <p>@UiText.T("Admin.Security.DisabledHelp", "尚未啟用。可搭配 Google Authenticator、Microsoft Authenticator 等應用程式。")</p>
            }
        </div>
        @if (!_status.Enabled)
        {
            @if (_setup is null)
            {
                <button type="button" class="button" disabled="@Blocked" @onclick="BeginSetup">@UiText.T("Admin.Security.BeginSetup", "開始設定")</button>
            }
            else
            {
                <div class="field">
                    <label for="totp-secret">@UiText.T("Admin.Security.Secret", "手動輸入金鑰（Base32）")</label>
                    <input id="totp-secret" class="code-input" value="@_setup.Value.Secret" readonly />
                    <p class="field-help">@UiText.T("Admin.Security.SecretHelp", "在驗證器應用程式新增「手動輸入」，貼上金鑰；或將下方網址貼入支援的應用程式。")</p>
                    <input class="code-input" value="@_setup.Value.Uri" readonly aria-label="@UiText.T("Admin.Security.OtpAuthLink", "otpauth 連結")" />
                </div>
                <EditForm Model="_confirm" OnValidSubmit="ConfirmSetup" FormName="totp-confirm">
                    <DataAnnotationsValidator />
                    <div class="field">
                        <label for="totp-code">@UiText.T("Admin.Security.SetupCode", "輸入應用程式顯示的 6 位碼")</label>
                        <input id="totp-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" @bind="_confirm.Code" @bind:event="oninput" required disabled="@Blocked" />
                    </div>
                    <div class="button-row">
                        <button type="submit" class="button" disabled="@Blocked">@UiText.T("Admin.Security.ConfirmSetup", "確認並啟用")</button>
                        <button type="button" class="button button-secondary" disabled="@Blocked" @onclick="BeginSetup">@UiText.T("Admin.Security.RegenerateSecret", "重新產生金鑰")</button>
                    </div>
                </EditForm>
                <p class="field-help">@UiText.T("Admin.Security.RecoveryHelp", "啟用後既有登入會失效。請妥善保管驗證器；admin-reset 只恢復全站管理者，不能恢復一般帳號。")</p>
            }
        }
        else
        {
            <EditForm Model="_disable" OnValidSubmit="Disable" FormName="totp-disable">
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="disable-password">@UiText.T("Admin.Security.CurrentPassword", "目前密碼")</label>
                    <input id="disable-password" type="password" maxlength="1024" @bind="_disable.Password" required disabled="@Blocked" autocomplete="current-password" />
                </div>
                <div class="field">
                    <label for="disable-code">@UiText.T("Admin.Security.Code", "動態驗證碼")</label>
                    <input id="disable-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" @bind="_disable.Code" @bind:event="oninput" required disabled="@Blocked" />
                </div>
                <button type="submit" class="button button-danger" disabled="@Blocked">@UiText.T("Admin.Security.Disable", "停用兩步驟驗證")</button>
            </EditForm>
        }
    </section>
}

@code {
    // 個人安全設定只需全域有效登入，不要求本站成員資格。
    protected override bool UsesSiteAccess => false;
    private TwoFactorStatus? _status;
    private AccountProfileEdit? _profile;
    private ChangePasswordInput _passwordForm = new();
    private (string Secret, string Uri)? _setup;
    private CodeInput _confirm = new();
    private PasswordAndCodeInput _disable = new();
    public static class ValidationText
    {
        public static string CodeRequired => UiText.T("Admin.Security.CodeRequired", "請輸入驗證碼。");
        public static string CodeLength => UiText.T("Admin.Security.CodeLength", "驗證碼為 6 位數字。");
        public static string PasswordRequired => UiText.T("Admin.Security.PasswordRequired", "請輸入密碼。");
        public static string PasswordTooLong => UiText.T("Admin.Security.PasswordTooLong", "密碼過長。");
    }
    private sealed class CodeInput
    {
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.CodeRequired))]
        [StringLength(6, MinimumLength = 6, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.CodeLength))]
        public string Code { get; set; } = "";
    }
    private sealed class PasswordAndCodeInput
    {
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.PasswordRequired))]
        [StringLength(1024, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.PasswordTooLong))]
        public string Password { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.CodeRequired))]
        [StringLength(6, MinimumLength = 6, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.CodeLength))]
        public string Code { get; set; } = "";
    }
    protected override Task OnInitializedAsync() => Load();
    private Task<bool> Load() => RunAsync(async ct =>
    {
        _status = await TwoFactor.GetStatusAsync(ct);
        _profile = await Api.GetMyProfileAsync(ct);
    });
    private Task SaveProfileAsync() => RunAsync(async ct =>
    {
        if (_profile is null) return;
        _profile = await Api.UpdateMyProfileAsync(_profile, ct);
    }, UiText.T("Admin.Security.ProfileSaved", "個人資料已更新。"));
    private async Task ChangePasswordAsync()
    {
        if (Blocked) return;
        try
        {
            await RunAsync(async ct =>
            {
                await Api.ChangeMyPasswordAsync(_passwordForm, ct);
            }, UiText.T("Admin.Security.PasswordUpdated", "密碼已更新。"));
        }
        finally
        {
            _passwordForm = new();
        }
    }
    private Task BeginSetup() => RunAsync(async ct =>
    {
        _setup = await TwoFactor.BeginSetupAsync(ct);
        _confirm.Code = "";
    });
    private Task ConfirmSetup() => RunAsync(async ct =>
    {
        await TwoFactor.EnableAsync(_confirm.Code, ct);
        _setup = null;
        _confirm.Code = "";
        _status = await TwoFactor.GetStatusAsync(ct);
    }, UiText.T("Admin.Security.Enabled", "兩步驟驗證已啟用，下次登入即需輸入動態驗證碼。"));
    private async Task Disable()
    {
        if (Blocked) return;
        try
        {
            await RunAsync(async ct =>
            {
                await TwoFactor.DisableAsync(_disable.Password, _disable.Code, ct);
                _status = await TwoFactor.GetStatusAsync(ct);
            }, UiText.T("Admin.Security.Disabled", "兩步驟驗證已停用。"));
        }
        finally { _disable = new(); }
    }
    protected override void Dispose(bool disposing)
    {
        _setup = null;
        _disable = new();
        _confirm.Code = "";
        base.Dispose(disposing);
    }
}
