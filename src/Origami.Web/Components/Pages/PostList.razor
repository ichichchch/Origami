@inject OrigamiClient Api
@inject MarkdownService Markdown
@inject NavigationManager Navigation
@inject ILogger<PostList> Logger

<section class="public-heading">
    <p class="eyebrow">@UiText.T("Public.PostList.01", "文字・觀點・日常")</p>
    @if (!string.IsNullOrEmpty(_category?.ParentSlug) && !string.IsNullOrEmpty(_category?.ParentTitle))
    {
        <p class="field-help"><a href="@(BasePath + (BasePath.Contains('?') ? "&" : "?") + "category=" + Uri.EscapeDataString(_category.ParentSlug))">@_category.ParentTitle</a> › @_category.Title</p>
    }
    <h1>@Heading<span class="heading-dot">.</span></h1>
    <p>@(_taxonomyDescription ?? (HasFilter ? UiText.T("Public.PostList.FilteredIntro", "探索這個主題的已發布文章。") : UiText.T("Public.PostList.Intro", "記錄想法，也分享值得留意的事。")))</p>
</section>
@if (_categories.Count > 0)
{
    <nav class="category-nav" aria-label="@UiText.T("Public.PostList.PopularCategories", "常用分類")">
        <a class="chip @(!HasFilter ? "selected" : "")" href="@BasePath">@UiText.T("Public.PostList.02", "全部文章")</a>
        @foreach (var category in _categories)
        {
            <a class="chip @(_category?.Slug == category.Slug ? "selected" : "")" href="@(BasePath + (BasePath.Contains('?') ? "&" : "?") + "category=" + Uri.EscapeDataString(category.Slug))">@category.Name <span class="muted">@category.Count</span></a>
        }
    </nav>
}
@if (HasFilter)
{
    <p class="field-help"><a href="@BasePath">@UiText.T("Public.PostList.03", "清除篩選，查看全部文章")</a>@if (_result is not null) { <span> · @string.Format(UiText.T("Public.PostList.ArticleCount", "共 {0} 篇"), _result.Total)</span> } · <a href="@FilteredFeedHref">@UiText.T("Public.PostList.04", "訂閱此篩選的文章 feed")</a></p>
}
@if (_error is not null)
{
    <div class="notice notice-error" role="alert">@_error <a href="@BasePath" data-enhance-nav="false">@UiText.T("Public.PostList.05", "重新載入")</a></div>
}
else if (_result is null)
{
    <p role="status">@UiText.T("Public.PostList.06", "正在載入文章…")</p>
}
else if (_result.Items.Count == 0)
{
    <section class="empty-state">
        <span class="empty-symbol" aria-hidden="true">—</span>
        <h2>@(HasFilter ? UiText.T("Public.PostList.FilteredEmpty", "這個組合還沒有文章") : UiText.T("Public.PostList.Empty", "故事，即將開始"))</h2>
        @if (HasFilter)
        {
            <p>@UiText.T("Public.PostList.07", "試試其他分類或標籤，或回到全部文章。")</p><a href="@BasePath">@UiText.T("Public.PostList.08", "瀏覽全部文章 →")</a>
        }
        else
        {
            <p>@UiText.T("Public.PostList.09", "目前還沒有公開文章。若你是網站管理員，登入後就能建立第一篇內容。")</p>
            <a class="button" href="/admin/posts" data-enhance-nav="false">@UiText.T("Public.PostList.10", "開始管理內容")</a>
            <p class="field-help">@UiText.T("Public.PostList.11", "建立草稿 → 加入分類與圖片 → 發布，文章就會出現在這裡。")</p>
        }
    </section>
}
else
{
    <div class="post-list">
        @foreach (var post in _result.Items)
        {
            <article class="post-preview">
                <time datetime="@post.PublishedAt?.ToString("O")">@post.PublishedAt?.ToString("yyyy.MM.dd") <span class="sr-only">UTC</span></time>
                <div class="post-summary"><h2>@if (post.IsSticky) { <span class="chip sticky-chip">@UiText.T("Public.PostList.12", "置頂")</span> } <a href="@("/posts/" + Uri.EscapeDataString(post.Slug))">@post.Title</a></h2>@if (post.CoverUrl is { } cover) { <a class="post-cover" href="@("/posts/" + Uri.EscapeDataString(post.Slug))" tabindex="-1" aria-hidden="true"><img src="@cover" alt="" loading="lazy" /></a> }<p>@(post.ExcerptIsManual ? post.Excerpt : Markdown.Excerpt(post.Excerpt))</p></div>
                <a class="read-link" href="@("/posts/" + Uri.EscapeDataString(post.Slug))" aria-label="@string.Format(UiText.T("Public.PostList.ReadArticle", "閱讀：{0}"), post.Title)">@UiText.T("Public.PostList.13", "閱讀全文")<span aria-hidden="true">↗</span></a>
            </article>
        }
    </div>
    <nav class="pagination" aria-label="@UiText.T("Public.PostList.Pagination", "文章分頁")">
        @if (_result.Page > 1) { <a class="button button-secondary" href="@PageUrl(_result.Page - 1)">@UiText.T("Public.PostList.14", "上一頁")</a> }
        <span>@string.Format(UiText.T("Public.PostList.PageStatus", "第 {0} / {1} 頁"), _result.Page, _result.TotalPages)</span>
        @if (_result.Page < _result.TotalPages) { <a class="button button-secondary" href="@PageUrl(_result.Page + 1)">@UiText.T("Public.PostList.15", "下一頁")</a> }
    </nav>
}

@code {
    // 可重複使用的公開文章列表：首頁與 /posts 列表共用此元件。
    // 查詢字串解析保留在所屬頁面；原始值以參數傳入。
    [Parameter] public string? Page { get; set; }
    [Parameter] public string? Category { get; set; }
    [Parameter] public string? Tag { get; set; }
    [Parameter] public int PageSize { get; set; } = Limits.PageSize;
    /// <summary>篩選與分頁所依據的路由，例如 "/" 或 "/posts"。</summary>
    [Parameter] public string BasePath { get; set; } = "/";
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private PagedResult<ContentSummary>? _result;
    private List<PublicTaxonomy> _categories = [];
    private TaxonomyView? _category;
    private TaxonomyView? _tag;
    private string? _error;
    private bool HasFilter => Category is not null || Tag is not null;
    private string? _taxonomyDescription;
    private string Heading => (_category, _tag) switch
    {
        ({ } category, { } tag) => category.Title + " · #" + tag.Title,
        ({ } category, _) => category.Title,
        (_, { } tag) => "#" + tag.Title,
        _ => UiText.T("Public.PostList.LatestArticles", "最新文章")
    };
    private string PageUrl(int page) => BasePath + (BasePath.Contains('?') ? "&" : "?") + "page=" + page
        + (_category is not null ? "&category=" + Uri.EscapeDataString(_category.Slug) : "")
        + (_tag is not null ? "&tag=" + Uri.EscapeDataString(_tag.Slug) : "");
    /// <summary>目前篩選條件的 RSS 訂閱網址（Atom 版本為 /feed/atom）。</summary>
    private string FilteredFeedHref
    {
        get
        {
            var parts = new List<string>();
            if (_category is not null) parts.Add("category=" + Uri.EscapeDataString(_category.Slug));
            if (_tag is not null) parts.Add("tag=" + Uri.EscapeDataString(_tag.Slug));
            return parts.Count == 0 ? "/feed" : "/feed?" + string.Join("&", parts);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _result = null;
        _error = null;
        _category = null;
        _tag = null;
        _taxonomyDescription = null;
        _categories = [];
        var page = 1;
        if (Page is not null && (!int.TryParse(Page, out page) || page < 1 || page > int.MaxValue / PageSize))
        { Missing(); return; }
        try
        {
            var ct = HttpContext?.RequestAborted ?? default;
            if (Category is not null)
            {
                _category = await Api.GetTaxonomyViewAsync(TaxonomyKind.Category, Category, ct);
                if (_category is null) { Missing(); return; }
                _taxonomyDescription = _category.Description != "" ? _category.Description : null;
            }
            if (Tag is not null)
            {
                _tag = await Api.GetTaxonomyViewAsync(TaxonomyKind.Tag, Tag, ct);
                if (_tag is null) { Missing(); return; }
                _taxonomyDescription ??= _tag.Description != "" ? _tag.Description : null;
            }
            _result = await Api.ListPublishedAsync(page, PageSize, _category?.Slug, _tag?.Slug, ct: ct);
            if (_result is null || page > _result.TotalPages) { Missing(); return; }
            _categories = await Api.GetPopularCategoriesAsync(ct) ?? [];
        }
        catch (CmsException) { Missing(); }
        catch (OperationCanceledException) when (HttpContext?.RequestAborted.IsCancellationRequested == true) { /* 訪客在渲染途中已斷線；無須處理。 */ }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Public article list unavailable");
            _error = UiText.T("Public.PostList.LoadError", "目前無法載入文章，請稍後再試。");
            if (HttpContext?.Response.HasStarted == false) HttpContext.Response.StatusCode = 503;
        }
    }

    private void Missing()
    {
        if (HttpContext?.Response.HasStarted == false) HttpContext.Response.StatusCode = 404;
        Navigation.NotFound();
    }
}
