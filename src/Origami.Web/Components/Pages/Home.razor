@page "/"
@inject ContentService Content
@inject SettingsService Settings
@inject MediaService Media
@inject MarkdownService Markdown
@inject ILogger<Home> Logger

<PageTitle>@HeadTitle</PageTitle>
<HeadContent>
    <link rel="alternate" type="application/rss+xml" title="@_settings.Name" href="/feed" />
    <meta name="description" content="@HomeDescription" />
    @* Filtered listings canonicalize to the plain home URL to avoid duplicate-content URLs. *@
    <link rel="canonical" href="@BaseUrl/" />
    <meta property="og:site_name" content="@_settings.Name" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@HeadTitle" />
    <meta property="og:description" content="@HomeDescription" />
    <meta property="og:url" content="@BaseUrl/" />
</HeadContent>
@if (_homePage is not null && !HasFilter)
{
    <article class="reading-column">
        <header class="article-heading"><p class="eyebrow">首頁</p><h1>@_homePage.Title</h1></header>
        <div class="prose">@((MarkupString)_homePageHtml)</div>
    </article>
    <p class="field-help home-posts-link">想看所有文章？<a href="/posts">前往文章列表 →</a></p>
}
else
{
    <PostList Page="@Page" Category="@Category" Tag="@Tag" PageSize="@(_settings.PostsPerPage ?? Limits.PageSize)" BasePath="/" />
}

@code {
    [SupplyParameterFromQuery(Name = "page")] public string? Page { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? Category { get; set; }
    [SupplyParameterFromQuery(Name = "tag")] public string? Tag { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private SiteSettings _settings = new();
    private PublicContent? _homePage;
    private string _homePageHtml = "";
    private string BaseUrl => HttpContext is null ? "" : HttpContext.Request.Scheme + "://" + HttpContext.Request.Host.Value;
    // A category or tag filter always reaches the article list, even when a static home page is set.
    private bool HasFilter => !string.IsNullOrWhiteSpace(Category) || !string.IsNullOrWhiteSpace(Tag);
    private bool ServesHomePage => _homePage is not null && !HasFilter;
    private string HeadTitle => ServesHomePage ? _homePage!.Title : _settings.Name;
    private string HomeDescription => !ServesHomePage
        ? _settings.Description
        : _homePage!.Excerpt != "" ? _homePage.Excerpt : Markdown.Excerpt(_homePage.Markdown);

    protected override async Task OnParametersSetAsync()
    {
        _homePage = null;
        _homePageHtml = "";
        try
        {
            var ct = HttpContext?.RequestAborted ?? default;
            _settings = await Settings.GetAsync(ct);
            // A configured static home page that stops being publicly readable falls back to the article list.
            if (_settings.HomePageContentId is { } homeId)
                _homePage = await Content.GetPublishedPageAsync(homeId, ct);
            if (_homePage is not null)
                _homePageHtml = Markdown.Render(_homePage.Markdown, await Media.PublicImageWidthsAsync(ct));
        }
        catch (OperationCanceledException) when (HttpContext?.RequestAborted.IsCancellationRequested == true) { /* The visitor disconnected mid-render; nothing to do. */ }
        catch (Exception ex) { Logger.LogError(ex, "Home page unavailable"); }
    }
}
