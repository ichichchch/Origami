@page "/posts/{Slug}"
@page "/pages/{Slug}"
@inject ContentService Content
@inject SettingsService Settings
@inject MediaService Media
@inject MarkdownService Markdown
@inject NavigationManager Navigation
@inject AdminAccess Admin
@inject SemanticSearchService Semantic
@inject ILogger<ContentDetail> Logger

<PageTitle>@(_content?.Title ?? "閱讀內容")</PageTitle>
@if (_content is not null)
{
    <HeadContent>
        @* Layout-level HeadContent is not emitted in Static SSR, so discovery links live on pages. *@
        <link rel="alternate" type="application/rss+xml" title="@_settings.Name" href="/feed" />
        @if (_locked || _isPrivate)
        {
            <meta name="robots" content="noindex" />
        }
        else
        {
            <meta name="description" content="@MetaDescription" />
            <link rel="canonical" href="@Canonical" />
            <meta property="og:site_name" content="@_settings.Name" />
            <meta property="og:title" content="@_content.Title" />
            <meta property="og:type" content="@(_content.Kind == ContentKind.Post ? "article" : "website")" />
            <meta property="og:url" content="@Canonical" />
            <meta property="og:description" content="@MetaDescription" />
            @if (_firstImage is not null)
            {
                <meta property="og:image" content="@AbsoluteImage" />
            }
            @if (_content.Kind == ContentKind.Post && _content.PublishedAt is { } published)
            {
                <meta property="article:published_time" content="@published.ToString("O")" />
            }
        }
    </HeadContent>
}
@if (_error is not null)
{
    <section class="empty-state" role="alert"><h1>暫時無法載入</h1><p>@_error</p><a href="/">回到首頁</a></section>
}
else if (_content is not null)
{
    <article class="reading-column">
        <a class="back-link" href="/">← 回到首頁</a>
        <header class="article-heading">
            <p class="eyebrow">@(_content.Kind == ContentKind.Post ? "文章" : "獨立頁面")@(_locked ? " · 受密碼保護" : "")@(_isPrivate ? " · 私密" : "")</p>
            <h1>@_content.Title</h1>
            @if (!_locked && _content.Kind == ContentKind.Post)
            {
                <time datetime="@_content.PublishedAt?.ToString("O")">@_content.PublishedAt?.ToString("yyyy 年 MM 月 dd 日") <span class="sr-only">UTC</span></time>
                @if (_content.Categories.Count > 0)
                {
                    <div class="chip-list" aria-label="分類">@foreach (var category in _content.Categories) { <a class="chip" href="@("/?category=" + Uri.EscapeDataString(category.Slug))">@category.Title</a> }</div>
                }
            }
        </header>
        @if (_locked)
        {
            <section class="protected-gate panel" aria-labelledby="protected-title">
                <h2 id="protected-title">這份內容受密碼保護</h2>
                <p class="field-help">輸入管理員提供的密碼即可閱讀；密碼變更後需重新解鎖。</p>
                @if (_unlockError is not null)
                {
                    <p class="notice notice-error" role="alert">@_unlockError</p>
                }
                @* Static SSR EditForm posts back here with an antiforgery token; no unlock ever signs a user in. *@
                <EditForm Model="_unlock" FormName="content-unlock" OnValidSubmit="UnlockAsync" Enhance="false">
                    <DataAnnotationsValidator />
                    <div class="field">
                        <label for="unlock-password">內容密碼</label>
                        <input id="unlock-password" type="password" @bind="_unlock.Password" autocomplete="off" maxlength="1024" required />
                    </div>
                    <button type="submit" class="button">解鎖內容</button>
                </EditForm>
            </section>
        }
        else
        {
            <div class="prose">@((MarkupString)_html)</div>
            @if (_content.Kind == ContentKind.Post && _content.Tags.Count > 0)
            {
                <footer class="article-tags" aria-label="標籤">@foreach (var tag in _content.Tags) { <a class="tag" href="@("/?tag=" + Uri.EscapeDataString(tag.Slug))"># @tag.Title</a> }</footer>
            }
        }
        @if (_content.Kind == ContentKind.Post && _neighbors.Count > 0)
        {
            <nav class="post-neighbors" aria-label="上一篇與下一篇">
                @foreach (var neighbor in _neighbors)
                {
                    <a class="neighbor-link" href="@("/posts/" + Uri.EscapeDataString(neighbor.Slug))">
                        <span>@(neighbor.IsNewer ? "下一篇 →" : "← 上一篇")</span>
                        <strong>@neighbor.Title</strong>
                    </a>
                }
            </nav>
        }
        @if (_content.Kind == ContentKind.Post && _related.Count > 0)
        {
            <aside class="related-posts" aria-labelledby="related-heading">
                <h2 id="related-heading">相關文章</h2>
                <ul>
                    @foreach (var item in _related)
                    {
                        <li><a href="@("/posts/" + Uri.EscapeDataString(item.Slug))">@item.Title</a><p>@item.Snippet</p></li>
                    }
                </ul>
            </aside>
        }
    </article>
}
else
{
    @if (!_redirecting) { <p role="status">正在載入內容…</p> }
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private PublicContent? _content;
    private SiteSettings _settings = new();
    private string? _firstImage;
    private string _html = "";
    private string? _error;
    private bool _redirecting;
    private bool _locked;
    private bool _isPrivate;
    private List<ContentNeighbor> _neighbors = [];
    private IReadOnlyList<SemanticHit> _related = [];
    private string? _unlockError;
    private UnlockInput _unlock = new();
    private sealed class UnlockInput
    {
        [Required(ErrorMessage = "請輸入內容密碼。")]
        [StringLength(1024)]
        public string Password { get; set; } = "";
    }
    private string UnlockCookieName => "origami.unlock." + _content?.Id.ToString("N");
    private string BaseUrl => HttpContext is null ? "" : HttpContext.Request.Scheme + "://" + HttpContext.Request.Host.Value;
    private string Canonical => BaseUrl + (_content?.Kind == ContentKind.Page ? "/pages/" : "/posts/") + Uri.EscapeDataString(_content?.Slug ?? "");
    private string MetaDescription => _content is null ? "" : _content.Excerpt != "" ? _content.Excerpt : Markdown.Excerpt(_content.Markdown);
    private string AbsoluteImage => _firstImage![0] == '/' ? BaseUrl + _firstImage : _firstImage!;
    protected override async Task OnParametersSetAsync()
    {
        _content = null;
        _firstImage = null;
        _html = "";
        _error = null;
        _redirecting = false;
        _locked = false;
        _isPrivate = false;
        _neighbors = [];
        _related = [];
        _unlockError = null;
        try
        {
            var ct = HttpContext?.RequestAborted ?? default;
            _settings = await Settings.GetAsync(ct);
            var kind = Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("pages/", StringComparison.OrdinalIgnoreCase) ? ContentKind.Page : ContentKind.Post;
            _content = await Content.GetPublishedAsync(kind, Slug, ct);
            if (_content is null)
            {
                // A retired slug of published content keeps working through a permanent redirect.
                var redirect = await Content.RedirectTargetAsync(Slug, ct);
                if (redirect is not null)
                {
                    if (HttpContext is not null && !HttpContext.Response.HasStarted)
                    {
                        HttpContext.Response.StatusCode = StatusCodes.Status301MovedPermanently;
                        HttpContext.Response.Headers.Location = "/" + (redirect.Kind == ContentKind.Page ? "pages/" : "posts/") + Uri.EscapeDataString(redirect.Slug);
                    }
                    _redirecting = true;
                    return;
                }
                if (HttpContext?.Response.HasStarted == false) HttpContext.Response.StatusCode = 404;
                Navigation.NotFound();
                return;
            }
            _locked = _content.IsProtected
                && !await Content.IsUnlockedAsync(_content.Id, HttpContext?.Request.Cookies[UnlockCookieName], ct);
            if (_content.IsPrivate)
            {
                // For anyone but the signed-in administrator, private content is indistinguishable from missing content.
                if (!await Admin.IsAdminAsync(ct))
                {
                    if (HttpContext?.Response.HasStarted == false) HttpContext.Response.StatusCode = 404;
                    Navigation.NotFound();
                    return;
                }
                _isPrivate = true;
            }
            if (!_locked)
            {
                await RenderBodyAsync(ct);
                await Content.RecordViewAsync(_content.Id, ct);
            }
        }
        catch (OperationCanceledException) when (HttpContext?.RequestAborted.IsCancellationRequested == true) { /* The visitor disconnected mid-render; nothing to do. */ }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Public content unavailable");
            _error = "目前無法讀取這篇內容，請稍後再試。";
            if (HttpContext?.Response.HasStarted == false) HttpContext.Response.StatusCode = 503;
        }
    }
    private async Task UnlockAsync()
    {
        if (_content is null || HttpContext is null || HttpContext.Response.HasStarted) return;
        try
        {
            var token = await Content.VerifyProtectionAsync(_content.Id, _unlock.Password, HttpContext.RequestAborted);
            if (token is null)
            {
                _unlock.Password = "";
                _unlockError = "密碼不正確，請再試一次。";
                return;
            }
            HttpContext.Response.Cookies.Append(UnlockCookieName, token, new CookieOptions
            {
                HttpOnly = true, Secure = true, SameSite = SameSiteMode.Lax, MaxAge = TimeSpan.FromDays(10)
            });
            _unlock.Password = "";
            _unlockError = null;
            _locked = false;
            await RenderBodyAsync(HttpContext.RequestAborted);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Content unlock failed");
            _unlockError = "解鎖失敗，請稍後再試。";
        }
    }
    private async Task RenderBodyAsync(CancellationToken ct)
    {
        _firstImage = Markdown.FirstImage(_content!.Markdown);
        _html = Markdown.Render(_content.Markdown, await Media.PublicImageWidthsAsync(ct));
        if (_content.Kind == ContentKind.Post)
        {
            _neighbors = await Content.NeighborsAsync(_content.Id, ct);
            // Related reads stored vectors only; an unindexed site simply shows nothing.
            _related = await Semantic.RelatedAsync(_content.Id, 3, ct);
        }
    }
}
