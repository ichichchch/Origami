@page "/archives"
@page "/archives/{Year:int}/{Month:int}"
@inject OrigamiClient Api
@inject MarkdownService Markdown
@inject NavigationManager Navigation
@inject ILogger<Archives> Logger

<PageTitle>@(IsOverview ? "文章歸檔" : $"{Year} 年 {Month} 月文章")</PageTitle>
@if (_error is not null)
{
    <section class="empty-state" role="alert"><h1>暫時無法載入</h1><p>@_error</p><a href="/">回到首頁</a></section>
}
else if (IsOverview)
{
    <section class="public-heading"><p class="eyebrow">按時間回顧</p><h1>文章歸檔<span class="heading-dot">.</span></h1><p>依發布月份整理所有公開文章。</p></section>
    @if (_months.Count == 0)
    {
        <section class="empty-state"><span class="empty-symbol" aria-hidden="true">—</span><h2>還沒有可歸檔的文章</h2><p>第一篇公開文章發布後，就會出現在這裡。</p></section>
    }
    else
    {
        <ul class="archive-list">
            @foreach (var month in _months)
            {
                <li><a href="@($"/archives/{month.Year}/{month.Month}")">@month.Year 年 @month.Month 月</a><span class="muted">@month.Count 篇</span></li>
            }
        </ul>
    }
}
else
{
    <section class="public-heading"><p class="eyebrow"><a href="/archives">所有月份</a></p><h1>@Year 年 @Month 月<span class="heading-dot">.</span></h1><p>這個月份發布的公開文章。</p></section>
    @if (_result is null)
    {
        <p role="status">正在載入文章…</p>
    }
    else if (_result.Items.Count == 0)
    {
        <section class="empty-state"><span class="empty-symbol" aria-hidden="true">—</span><h2>這個月份沒有文章</h2><p>換個月份，或<a href="/archives">查看所有月份</a>。</p></section>
    }
    else
    {
        <div class="post-list">
            @foreach (var post in _result.Items)
            {
                <article class="post-preview">
                    <time datetime="@post.PublishedAt?.ToString("O")">@post.PublishedAt?.ToString("yyyy.MM.dd") <span class="sr-only">UTC</span></time>
                    <div class="post-summary"><h2><a href="@("/posts/" + Uri.EscapeDataString(post.Slug))">@post.Title</a></h2><p>@(post.ExcerptIsManual ? post.Excerpt : Markdown.Excerpt(post.Excerpt))</p></div>
                    <a class="read-link" href="@("/posts/" + Uri.EscapeDataString(post.Slug))" aria-label="@("閱讀：" + post.Title)">閱讀全文 <span aria-hidden="true">↗</span></a>
                </article>
            }
        </div>
        <nav class="pagination" aria-label="文章分頁">
            @if (_result.Page > 1) { <a class="button button-secondary" href="@PageUrl(_result.Page - 1)">上一頁</a> }
            <span>第 @_result.Page / @_result.TotalPages 頁</span>
            @if (_result.Page < _result.TotalPages) { <a class="button button-secondary" href="@PageUrl(_result.Page + 1)">下一頁</a> }
        </nav>
    }
}

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? Page { get; set; }
    private List<ArchiveMonth> _months = [];
    private PagedResult<ContentSummary>? _result;
    private string? _error;
    private bool IsOverview => Year == 0;

    protected override async Task OnParametersSetAsync()
    {
        _months = [];
        _result = null;
        _error = null;
        try
        {
            var ct = default(CancellationToken);
            if (IsOverview)
            {
                _months = await Api.GetArchivesAsync(ct) ?? [];
                return;
            }
            if (Month is < 1 or > 12)
            {
                Navigation.NotFound();
                return;
            }
            var page = int.TryParse(Page, out var parsed) && parsed > 0 ? parsed : 1;
            _result = await Api.ListPublishedAsync(page, Limits.MaxPageSize, year: Year, month: Month, ct: ct);
        }
        catch (CmsException)
        {
            Navigation.NotFound();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Archive page unavailable");
            _error = "目前無法載入歸檔，請稍後再試。";
        }
    }

    private string PageUrl(int page) => $"/archives/{Year}/{Month}" + (page > 1 ? "?page=" + page : "");
}
