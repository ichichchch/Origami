@page "/t/{Slug}/{ContentSlug}"
@inject OrigamiClient Api
@inject MarkdownService Markdown
@inject NavigationManager Navigation
@inject ILogger<TypeContent> Logger

<PageTitle>@UiText.T("Public.TypeContent.PageTitle", "{0} · 內容專區")</PageTitle>
<HeadContent>
    <meta name="description" content="@_metaDescription" />
    <link rel="canonical" href="@(BaseUrl + "/t/" + Uri.EscapeDataString(Slug ?? "") + "/" + Uri.EscapeDataString(ContentSlug ?? ""))" />
    <meta property="og:site_name" content="@_settings.Name" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="@_title" />
    <meta property="og:description" content="@_metaDescription" />
</HeadContent>
@if (_error is not null)
{
    <div class="notice notice-error" role="alert">@_error</div>
}
else if (_content is null)
{
    <p role="status">@UiText.T("Public.TypeContent.Loading", "正在載入內容…")</p>
}
else
{
    <article class="reading-column">
        <a class="back-link" href="@("/t/" + Uri.EscapeDataString(Slug ?? ""))">@UiText.T("Public.TypeContent.Back", "← 回到專區")</a>
        <header class="article-heading">
            <p class="eyebrow">@_typeName</p>
            <h1>@_content.Title</h1>
            @if (_content.PublishedAt is { } published)
            {
                <time datetime="@published.ToString("O")">@published.ToString(UiText.T("Public.ContentDetail.PublishedDateFormat", "yyyy 年 MM 月 dd 日"), CultureInfo.CurrentUICulture) <span class="sr-only">UTC</span></time>
            }
            @if (!string.IsNullOrWhiteSpace(_content.AuthorName))
            {
                <p class="byline">@UiText.T("Public.ContentDetail.Author", "作者") · @_content.AuthorName</p>
            }
        </header>
        @if (_content.CoverUrl is { } coverUrl)
        {
            <figure class="cover-figure">
                <img src="@coverUrl" alt="@_content.CoverAltText" loading="lazy" />
                @if (_content.CoverCaption != "") { <figcaption>@_content.CoverCaption</figcaption> }
            </figure>
        }
        <div class="prose">@((MarkupString)_html)</div>
        @if (_content.CustomTerms.Count > 0)
        {
            <div class="chip-list" aria-label="自訂分類詞彙">
                @foreach (var term in _content.CustomTerms)
                {
                    <a class="chip" href="@($"/t/{Uri.EscapeDataString(Slug ?? "")}/{Uri.EscapeDataString(term.TaxonomySlug)}/{Uri.EscapeDataString(term.TermSlug)}")">@term.TaxonomyName：@term.TermName</a>
                }
            </div>
        }
        @if (_content.Fields.Count > 0)
        {
            <dl class="field-list" aria-label="@UiText.T("Public.TypeContent.Fields", "自訂欄位")">
                @foreach (var field in _content.Fields)
                {
                    <div class="field-list-row">
                        <dt>@field.Name</dt>
                        <dd>@FieldText(field)</dd>
                    </div>
                }
            </dl>
        }
    </article>
}

@code {
    [Parameter] public string? Slug { get; set; }
    [Parameter] public string? ContentSlug { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private PublicSiteSettings _settings = PublicSiteSettings.Default;
    private PublicContent? _content;
    private string _html = "";
    private string _error = "";
    private string _title = "";
    private string _typeName = "";
    private string _metaDescription = "";
    private string BaseUrl => HttpContext is null ? "" : HttpContext.Request.Scheme + "://" + HttpContext.Request.Host.Value;

    protected override async Task OnParametersSetAsync()
    {
        _content = null;
        _error = "";
        try
        {
            var ct = HttpContext?.RequestAborted ?? default;
            _settings = await Api.GetPublicSettingsAsync(ct) ?? _settings;
            var types = await Api.ListPublicTypesAsync(ct);
            var type = types.FirstOrDefault(x => string.Equals(x.Slug, Slug, StringComparison.OrdinalIgnoreCase));
            if (type is null) { Missing(); return; }
            _typeName = type.Name;
            _content = await Api.GetTypeContentAsync(type.Slug, ContentSlug ?? "", ct);
            if (_content is null) { Missing(); return; }
            _title = _content.Title;
            _metaDescription = _content.MetaDescription != "" ? _content.MetaDescription : _content.Excerpt;
            _html = Markdown.Render(_content.Markdown, await Api.GetPublicImageWidthsAsync(ct) ?? []);
        }
        catch (CmsException) { Missing(); }
        catch (OperationCanceledException) when (HttpContext?.RequestAborted.IsCancellationRequested == true) { /* 訪客在渲染途中已斷線；無須處理。 */ }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Content type detail unavailable");
            _error = UiText.T("Public.TypeContent.LoadError", "目前無法載入這份內容，請稍後再試。");
            if (HttpContext?.Response.HasStarted == false) HttpContext.Response.StatusCode = 503;
        }
    }

    private void Missing()
    {
        if (HttpContext?.Response.HasStarted == false) HttpContext.Response.StatusCode = 404;
        Navigation.NotFound();
    }

    /// <summary>自訂欄位值的公開文字；核取方塊以是／否呈現。</summary>
    private static string FieldText(PublicFieldValue field)
    {
        if (field.FieldType != CustomFieldTypes.Checkbox) return field.Value;
        if (field.Value == "true") return UiText.T("Public.TypeContent.Yes", "是");
        return UiText.T("Public.TypeContent.No", "否");
    }
}
