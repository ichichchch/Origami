@page "/not-found"
@inject PublicSettingsProvider Settings
<PageTitle>@Title</PageTitle>
<section class="empty-state error-page">
    <p class="eyebrow">404</p><h1>@Title</h1>
    <p>@Body</p>
    <a class="button" href="/">@UiText.T("Public.NotFound.05", "回到首頁")</a>
</section>
@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    // 站點可自訂 404 標題與說明（純文字、輸出編碼）；未設定時沿用預設文案。
    private string _title = "";
    private string _body = "";
    private string Title => _title.Length > 0 ? _title : UiText.T("Public.NotFound.02", "這一頁，暫時缺席。");
    private string Body => _body.Length > 0 ? _body
        : UiText.T("Public.NotFound.03", "網址可能已變更，或內容尚未公開。") + " " + UiText.T("Public.NotFound.04", "回到首頁，看看其他故事吧。");

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext?.Response.HasStarted == false) HttpContext.Response.StatusCode = 404;
        try
        {
            var settings = await Settings.GetAsync(HttpContext?.RequestAborted ?? default);
            _title = settings?.NotFoundTitle ?? "";
            _body = settings?.NotFoundBody ?? "";
        }
        catch (OperationCanceledException) when (HttpContext?.RequestAborted.IsCancellationRequested == true) { }
        catch (Exception ex) when (ex is CmsException or HttpRequestException or TaskCanceledException)
        {
            // 設定讀取失敗時顯示預設文案；404 本身不受影響。
        }
    }
}
